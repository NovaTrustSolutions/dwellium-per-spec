+/**
+ * Deterministic stand-in for the `openai` SDK (plan 052 tests).
+ *
+ *   jest.mock('openai', () => require('./helpers/fakeOpenAI').fakeOpenAIModule());
+ *
+ * Embeddings are tiny keyword-count vectors so cosine similarity behaves
+ * semantically enough for tests: texts sharing keywords score high, texts
+ * sharing none score 0 (below ARA's 0.25 floor), and a no-keyword query is
+ * the zero vector (matches nothing). Chat completions return a canned reply.
+ */
+const DIMS = ['lease', 'notice', 'renewal', 'woodland', 'vendor', 'insurance', 'hvac', 'contractor', 'deposit'];
+
+export function fakeEmbedding(text: string): number[] {
+    const lower = text.toLowerCase();
+    return DIMS.map(d => (lower.match(new RegExp(d, 'g')) || []).length);
+}
+
+export function fakeOpenAIModule() {
+    class OpenAI {
+        embeddings = {
+            create: async ({ input }: { input: string | string[] }) => ({
+                data: (Array.isArray(input) ? input : [input]).map((t, index) => ({ index, embedding: fakeEmbedding(t) })),
+            }),
+        };
+        chat = { completions: { create: async () => ({ choices: [{ message: { content: '{"results":[]}' } }] }) } };
+    }
+    return { __esModule: true, default: OpenAI, OpenAI };
+}
