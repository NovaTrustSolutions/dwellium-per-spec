+            return new Response(JSON.stringify({ choices: [{ message: { content: 'Sixty days, per the lease.' }, finish_reason: 'stop' }], usage: { total_tokens: 10 } }), { status: 200, headers: { 'Content-Type': 'application/json' } });
+        }) as any;
