+++ b/ai-dashboard369-file-manager/tests/esignRoutes.test.ts
@@ -0,0 +1,202 @@
+/**
+ * /api/esign + /api/webhooks/documenso (plan 047 phase 1).
+ *
+ * Env unset → 503 with needsSetup:true everywhere (never a crash, never an
+ * open sink); approved lease + mocked Documenso → docStatus sent + envelope
+ * metadata; webhook drives signed/countersigned. UPSERT-only metadata writes.
+ */
+import { makeApp, createTestUser, TestUser } from './helpers/harness';
+
+// Require AFTER harness so the store opens its isolated temp SQLite.
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const store = require('../src/stores/dwelliumStore');
+
+const ENV_KEYS = ['DOCUMENSO_API_URL', 'DOCUMENSO_API_KEY', 'DOCUMENSO_WEBHOOK_SECRET', 'DOCUMENSO_TEMPLATE_LEASE'] as const;
+const savedEnv: Record<string, string | undefined> = {};
+beforeAll(() => { for (const k of ENV_KEYS) savedEnv[k] = process.env[k]; });
+beforeEach(() => { for (const k of ENV_KEYS) delete process.env[k]; });
+afterAll(() => {
+    for (const k of ENV_KEYS) {
+        if (savedEnv[k] === undefined) delete process.env[k]; else process.env[k] = savedEnv[k];
+    }
+});
+
+function makeLease(metadata: Record<string, unknown>) {
+    return store.createWorkitem({ type: 'lease', title: 'Lease — itest unit', metadata });
+}
+
+function setDocumensoEnv() {
+    process.env.DOCUMENSO_API_URL = 'https://esign.test';
+    process.env.DOCUMENSO_API_KEY = 'api_test_key';
+}
+
+/** Minimal fetch stub — response-shaped objects, no undici dependency. */
+function jsonResponse(body: unknown, status = 200) {
+    return {
+        ok: status >= 200 && status < 300,
+        status,
+        json: async () => body,
+        arrayBuffer: async () => new ArrayBuffer(0),
+        headers: { get: () => 'application/json' },
+    };
+}
+
+describe('/api/esign env gate (Documenso not configured)', () => {
+    let mgmt: TestUser;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+
+    it('503 with needsSetup:true on every route when DOCUMENSO_* env is unset', async () => {
+        const lease = makeLease({ docStatus: 'approved' });
+        const calls = [
+            () => makeApp().get('/api/esign/documents').set('Authorization', mgmt.authHeader),
+            () => makeApp().get(`/api/esign/leases/${lease.id}/status`).set('Authorization', mgmt.authHeader),
+            () => makeApp().post(`/api/esign/leases/${lease.id}/send`).set('Authorization', mgmt.authHeader).send({}),
+            () => makeApp().get(`/api/esign/leases/${lease.id}/signed-pdf`).set('Authorization', mgmt.authHeader),
+        ];
+        for (const call of calls) {
+            const r = await call();
+            expect(r.status).toBe(503);
+            expect(r.body.success).toBe(false);
+            expect(r.body.needsSetup).toBe(true);
+            expect(r.body.error).toMatch(/DOCUMENSO_API_URL/);
+        }
+    });
+
+    it('401 without a session (authenticate runs before the env gate)', async () => {
+        const r = await makeApp().get('/api/esign/documents');
+        expect(r.status).toBe(401);
+    });
+
+    it('403 for a tenant session (management-gated) — role checked before env', async () => {
+        const tenant = await createTestUser({ role: 'tenant' });
+        const r = await makeApp().get('/api/esign/documents').set('Authorization', tenant.authHeader);
+        expect(r.status).toBe(403);
+    });
+});
+
+describe('POST /api/esign/leases/:id/send (Documenso mocked)', () => {
+    let mgmt: TestUser;
+    const realFetch = (global as any).fetch;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+    afterEach(() => { (global as any).fetch = realFetch; });
+
+    it('approved → 200: envelope recorded, docStatus=sent, docHistory appended', async () => {
+        setDocumensoEnv();
+        const urls: string[] = [];
+        (global as any).fetch = async (url: unknown) => {
+            urls.push(String(url));
+            if (String(url).endsWith('/send')) {
+                return jsonResponse({ recipients: [{ email: 't@example.com', role: 'signer', token: 'tok_1' }] });
+            }
+            return jsonResponse({ id: 'env_123' });
+        };
+        const lease = makeLease({ docStatus: 'approved', applicantEmail: 't@example.com', applicantName: 'Test Tenant' });
+        const r = await makeApp().post(`/api/esign/leases/${lease.id}/send`).set('Authorization', mgmt.authHeader).send({});
+        expect(r.status).toBe(200);
+        expect(r.body.data.envelopeId).toBe('env_123');
+        expect(urls).toEqual([
+            'https://esign.test/api/v2/envelopes',
+            'https://esign.test/api/v2/envelopes/env_123/send',
+        ]);
+        const after = store.getWorkitem(lease.id);
+        expect(after.metadata.docStatus).toBe('sent');
+        expect(after.metadata.esign.envelopeId).toBe('env_123');
+        expect(after.metadata.esign.recipients[0].token).toBe('tok_1');
+        expect(after.metadata.docHistory[after.metadata.docHistory.length - 1]).toMatchObject({ from: 'approved', to: 'sent' });
+    });
+
+    it('draft → 400, Documenso never called', async () => {
+        setDocumensoEnv();
+        let called = 0;
+        (global as any).fetch = async () => { called += 1; return jsonResponse({ id: 'nope' }); };
+        const lease = makeLease({ docStatus: 'draft', applicantEmail: 't@example.com' });
+        const r = await makeApp().post(`/api/esign/leases/${lease.id}/send`).set('Authorization', mgmt.authHeader).send({});
+        expect(r.status).toBe(400);
+        expect(r.body.error).toMatch(/approve/i);
+        expect(called).toBe(0);
+        expect(store.getWorkitem(lease.id).metadata.docStatus).toBe('draft');
+    });
+
+    it('no recipient email anywhere → 400', async () => {
+        setDocumensoEnv();
+        const lease = makeLease({ docStatus: 'approved' });
+        const r = await makeApp().post(`/api/esign/leases/${lease.id}/send`).set('Authorization', mgmt.authHeader).send({});
+        expect(r.status).toBe(400);
+        expect(r.body.error).toMatch(/recipient/i);
+    });
+
+    it('Documenso 500 → 502; docStatus unchanged', async () => {
+        setDocumensoEnv();
+        (global as any).fetch = async () => jsonResponse({ error: 'boom' }, 500);
+        const lease = makeLease({ docStatus: 'approved', applicantEmail: 't@example.com' });
+        const r = await makeApp().post(`/api/esign/leases/${lease.id}/send`).set('Authorization', mgmt.authHeader).send({});
+        expect(r.status).toBe(502);
+        expect(store.getWorkitem(lease.id).metadata.docStatus).toBe('approved');
+    });
+
+    it('unknown workitem → 404', async () => {
+        setDocumensoEnv();
+        const r = await makeApp().post('/api/esign/leases/wi-does-not-exist/send').set('Authorization', mgmt.authHeader).send({});
+        expect(r.status).toBe(404);
+    });
+});
+
+describe('GET /api/esign/documents + /status (Documenso configured)', () => {
+    let mgmt: TestUser;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+
+    it('lists only leases with an envelope; status returns esign metadata', async () => {
+        setDocumensoEnv();
+        const sent = makeLease({ docStatus: 'sent', esign: { envelopeId: 'env_list_1', recipients: [{ email: 'a@example.com' }], sentAt: '2026-08-20T00:00:00.000Z' } });
+        makeLease({ docStatus: 'draft' }); // no envelope → not listed
+        const r = await makeApp().get('/api/esign/documents').set('Authorization', mgmt.authHeader);
+        expect(r.status).toBe(200);
+        const row = r.body.data.find((d: { envelopeId: string }) => d.envelopeId === 'env_list_1');
+        expect(row).toMatchObject({ workitemId: sent.id, docStatus: 'sent' });
+        expect(r.body.data.some((d: { workitemId: string }) => d.workitemId === sent.id)).toBe(true);
+
+        const st = await makeApp().get(`/api/esign/leases/${sent.id}/status`).set('Authorization', mgmt.authHeader);
+        expect(st.status).toBe(200);
+        expect(st.body.data.esign.envelopeId).toBe('env_list_1');
+    });
+});
+
+describe('POST /api/webhooks/documenso', () => {
+    it('503 when DOCUMENSO_WEBHOOK_SECRET is unset (never an open sink)', async () => {
+        const r = await makeApp().post('/api/webhooks/documenso').set('x-documenso-secret', 'anything').send({ event: 'DOCUMENT_SIGNED', payload: { envelopeId: 'x' } });
+        expect(r.status).toBe(503);
+        expect(r.body).toEqual({ success: false, error: 'DOCUMENSO_WEBHOOK_SECRET not configured' });
+    });
+
+    it('401 on a missing or wrong secret', async () => {
+        process.env.DOCUMENSO_WEBHOOK_SECRET = 'whsec-correct';
+        expect((await makeApp().post('/api/webhooks/documenso').send({})).status).toBe(401);
+        expect((await makeApp().post('/api/webhooks/documenso').set('x-documenso-secret', 'whsec-wrong--').send({})).status).toBe(401);
+    });
+
+    it('DOCUMENT_COMPLETED → countersigned; unknown events acknowledged as ignored', async () => {
+        process.env.DOCUMENSO_WEBHOOK_SECRET = 'whsec-correct';
