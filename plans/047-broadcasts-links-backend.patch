@@ -0,0 +1,172 @@
+/**
+ * /api/broadcasts — listmonk proxy (plan 047 phase 2).
+ *
+ * Env unset → 503 with needsSetup:true everywhere (never a crash); 401 without
+ * a session; 403 for tenants (management-gated). With env set + fetch mocked:
+ * lists/campaigns proxy with `Authorization: token user:token`, POST creates a
+ * DRAFT campaign, test-send re-reads the campaign then posts subscribers.
+ */
+import { makeApp, createTestUser, TestUser } from './helpers/harness';
+
+const ENV_KEYS = ['LISTMONK_URL', 'LISTMONK_USER', 'LISTMONK_TOKEN'] as const;
+const savedEnv: Record<string, string | undefined> = {};
+beforeAll(() => { for (const k of ENV_KEYS) savedEnv[k] = process.env[k]; });
+beforeEach(() => { for (const k of ENV_KEYS) delete process.env[k]; });
+afterAll(() => {
+    for (const k of ENV_KEYS) {
+        if (savedEnv[k] === undefined) delete process.env[k]; else process.env[k] = savedEnv[k];
+    }
+});
+
+function setListmonkEnv() {
+    process.env.LISTMONK_URL = 'https://lists.test';
+    process.env.LISTMONK_USER = 'dwellium';
+    process.env.LISTMONK_TOKEN = 'tok_test';
+}
+
+/** Minimal fetch stub — response-shaped objects (esignRoutes.test.ts pattern). */
+function jsonResponse(body: unknown, status = 200) {
+    return {
+        ok: status >= 200 && status < 300,
+        status,
+        json: async () => body,
+        headers: { get: () => 'application/json' },
+    };
+}
+
+describe('/api/broadcasts env gate (listmonk not configured)', () => {
+    let mgmt: TestUser;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+
+    it('503 with needsSetup:true on every route when LISTMONK_* env is unset', async () => {
+        const calls = [
+            () => makeApp().get('/api/broadcasts/lists').set('Authorization', mgmt.authHeader),
+            () => makeApp().get('/api/broadcasts/templates').set('Authorization', mgmt.authHeader),
+            () => makeApp().get('/api/broadcasts/campaigns').set('Authorization', mgmt.authHeader),
+            () => makeApp().post('/api/broadcasts/campaigns').set('Authorization', mgmt.authHeader).send({ subject: 'Hi', lists: [1] }),
+            () => makeApp().post('/api/broadcasts/campaigns/1/test').set('Authorization', mgmt.authHeader).send({ subscribers: ['a@example.com'] }),
+        ];
