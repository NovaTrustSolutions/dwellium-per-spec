+/** Create a mailing list (audience). Defaults: private, single opt-in. */
+router.post('/lists', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
