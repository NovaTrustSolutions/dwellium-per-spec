+/**
+ * Index already-extracted text (plan 052 Library): chunk, embed, then atomically
+ * replace this fileId's chunks. No filesystem. The caller owns the `files` row
+ * (embeddings.file_id → files.id FK). Throws when embeddings are unavailable so
+ * a bad key never leaves un-embedded chunks behind.
+ */
+export async function indexText(fileId: string, name: string, text: string): Promise<{
+    chunksIndexed: number;
+    totalChars: number;
+}> {
+    const chunks = chunkText(text);
+    const vectors: Buffer[] = [];
+    for (let i = 0; i < chunks.length; i++) {
+        const embedding = await generateEmbedding(chunks[i]);
+        if (!embedding) throw new Error('embeddings not configured');
+        vectors.push(embeddingToBuffer(embedding));
+        if (i > 0 && i % 50 === 0) await new Promise(resolve => setTimeout(resolve, 1000)); // same pacing as indexDocument
+    }
+    database.transaction(() => {
+        deleteEmbeddingsByFile(fileId);
+        chunks.forEach((textContent, chunkIndex) => storeEmbedding({
+            id: crypto.randomUUID(), fileId, chunkIndex, textContent, embedding: vectors[chunkIndex]
+        }));
+    })();
+    console.log(`[VectorStore] Indexed ${chunks.length} chunks for ${name} (${text.length} chars)`);
+    return { chunksIndexed: chunks.length, totalChars: text.length };
+}
