+/**
+ * /api/library (plan 052) — NotebookLM mirror: upsert-by-hash indexing, secret-or-session auth,
+ * status/list/delete. Real app + isolated temp DB (harness); `openai` replaced by a deterministic fake.
+ */
+jest.mock('openai', () => require('./helpers/fakeOpenAI').fakeOpenAIModule());
+
+process.env.OPENAI_API_KEY = 'sk-test-library';
+
+import { makeApp, createTestUser, TestUser } from './helpers/harness';
+// Same module instance as the app's (harness set the data dir first) — lets us count chunk rows directly.
+import { database } from '../src/services/database';
+
+const SECRET = 'sync-secret-' + 'x'.repeat(20);
+const chunkRows = (id: string) => (database.prepare('SELECT COUNT(*) AS n FROM embeddings WHERE file_id = ?').get(id) as { n: number }).n;
+const LONG = 'Woodland Parc lease notice terms. '.repeat(80); // ~2.7k chars → 4 chunks
+const SHORT = 'The Woodland Parc lease requires sixty days written notice for non-renewal.';
+const body = (over: Record<string, unknown> = {}) => ({ collection: 'contracts', sourceId: 'src-1', title: 'Woodland Parc Lease', text: LONG, url: 'https://notebooklm.google.com/x', notebookId: 'nb1', notebookTitle: 'Contracts', ...over });
+
+describe('/api/library', () => {
+    let corporate: TestUser; let management: TestUser;
+    const savedSecret = process.env.LIBRARY_SYNC_SECRET;
+
+    beforeAll(async () => {
+        corporate = await createTestUser({ role: 'corporate' });
+        management = await createTestUser({ role: 'management' });
+    });
+    beforeEach(() => { process.env.LIBRARY_SYNC_SECRET = SECRET; process.env.OPENAI_API_KEY = 'sk-test-library'; });
+    afterAll(() => { if (savedSecret === undefined) delete process.env.LIBRARY_SYNC_SECRET; else process.env.LIBRARY_SYNC_SECRET = savedSecret; });
+
+    const post = (hdr: Record<string, string>, b: unknown = body()) => makeApp().post('/api/library/sources').set(hdr).send(b);
+
+    describe('auth', () => {
+        it('401 without a session or secret; 403 for a non-admin session', async () => {
+            expect((await post({})).status).toBe(401);
+            expect((await post({ Authorization: management.authHeader })).status).toBe(403);
+        });
+        it('401 on a wrong secret, and when LIBRARY_SYNC_SECRET is unset (header path disabled)', async () => {
+            expect((await post({ 'x-library-secret': 'nope' })).status).toBe(401);
+            expect((await post({ 'x-library-secret': SECRET.slice(0, -1) })).status).toBe(401);
+            delete process.env.LIBRARY_SYNC_SECRET;
+            expect((await post({ 'x-library-secret': SECRET })).status).toBe(401);
+            // a wrong header is not rescued by a valid admin bearer
+            expect((await post({ 'x-library-secret': 'nope', Authorization: corporate.authHeader })).status).toBe(401);
+        });
+        it('GET /status and /sources need a session (any role)', async () => {
+            expect((await makeApp().get('/api/library/status')).status).toBe(401);
+            expect((await makeApp().get('/api/library/sources').set('Authorization', management.authHeader)).status).toBe(200);
+        });
+    });
+
+    describe('POST /sources', () => {
+        it('400 on missing fields', async () => {
+            const r = await post({ 'x-library-secret': SECRET }, body({ text: '' }));
+            expect(r.status).toBe(400);
+            expect(r.body).toEqual({ success: false, error: 'text is required' });
+            expect((await post({ 'x-library-secret': SECRET }, { collection: 'c', sourceId: 's', text: 'hello world text' })).status).toBe(400);
+        });
+
+        it('503 when embeddings are not configured', async () => {
+            delete process.env.OPENAI_API_KEY;
+            const r = await post({ 'x-library-secret': SECRET });
+            expect(r.status).toBe(503);
+            expect(r.body).toEqual({ success: false, error: 'embeddings not configured' });
+        });
+
+        it('creates → unchanged on same hash → re-indexes (replacing chunks) on new text', async () => {
+            const id = 'library:contracts:src-1';
+            const created = await post({ 'x-library-secret': SECRET });
+            expect(created.status).toBe(200);
+            expect(created.body).toMatchObject({ success: true, id, unchanged: false });
+            expect(created.body.chunks).toBeGreaterThan(1);
+            expect(chunkRows(id)).toBe(created.body.chunks);
+
+            const again = await post({ Authorization: corporate.authHeader }); // admin session path, same text
+            expect(again.status).toBe(200);
+            expect(again.body).toEqual({ success: true, id, chunks: created.body.chunks, unchanged: true });
+            expect(chunkRows(id)).toBe(created.body.chunks);
+
+            const changed = await post({ 'x-library-secret': SECRET }, body({ text: SHORT, title: 'Woodland Parc Lease v2' }));
+            expect(changed.status).toBe(200);
+            expect(changed.body).toEqual({ success: true, id, chunks: 1, unchanged: false });
+            expect(chunkRows(id)).toBe(1); // old chunks replaced, not accumulated
+
+            const list = await makeApp().get('/api/library/sources').set('Authorization', management.authHeader);
+            expect(list.status).toBe(200);
+            expect(list.body.sources).toHaveLength(1);
+            expect(list.body.sources[0]).toMatchObject({
+                id, collection: 'contracts', sourceId: 'src-1', notebookId: 'nb1', notebookTitle: 'Contracts',
+                title: 'Woodland Parc Lease v2', url: 'https://notebooklm.google.com/x', chars: SHORT.length, chunks: 1,
+            });
+            expect(list.body.sources[0].contentHash).toMatch(/^[a-f0-9]{64}$/);
+            expect(list.body.sources[0].updatedAt).toBeTruthy();
+        });
+    });
+
+    describe('GET /status and DELETE /sources/:id', () => {
+        it('status aggregates per collection; delete removes one source and its chunks only', async () => {
+            await post({ 'x-library-secret': SECRET }, body({ collection: 'housing-law', sourceId: 'ga-1', title: 'GA Landlord Tenant Handbook', text: 'Security deposit must be returned within thirty days. '.repeat(10) }));
+            const status = await makeApp().get('/api/library/status').set('Authorization', management.authHeader);
+            expect(status.status).toBe(200);
+            expect(status.body).toMatchObject({ success: true, embeddingsConfigured: true, sources: 2 });
+            expect(status.body.collections).toEqual(expect.arrayContaining([
+                expect.objectContaining({ name: 'contracts', sources: 1 }),
+                expect.objectContaining({ name: 'housing-law', sources: 1 }),
+            ]));
+            expect(status.body.collections[0].lastSyncedAt).toBeTruthy();
+            expect(status.body.lastSyncedAt).toBeTruthy();
+
+            expect((await makeApp().delete('/api/library/sources/library:contracts:src-1').set('Authorization', management.authHeader)).status).toBe(403);
+            const del = await makeApp().delete('/api/library/sources/library:contracts:src-1').set('Authorization', corporate.authHeader);
+            expect(del.status).toBe(200);
+            expect(del.body).toEqual({ success: true });
+            expect(chunkRows('library:contracts:src-1')).toBe(0);
+            expect(chunkRows('library:housing-law:ga-1')).toBeGreaterThan(0);
+
+            const list = await makeApp().get('/api/library/sources').set('Authorization', corporate.authHeader);
+            expect(list.body.sources.map((s: any) => s.id)).toEqual(['library:housing-law:ga-1']);
+            const after = await makeApp().get('/api/library/status').set('Authorization', corporate.authHeader);
+            expect(after.body.sources).toBe(1);
+        });
+
+        it('status reports embeddingsConfigured:false without OPENAI_API_KEY', async () => {
+            delete process.env.OPENAI_API_KEY;
+            const r = await makeApp().get('/api/library/status').set('Authorization', management.authHeader);
+            expect(r.body.embeddingsConfigured).toBe(false);
+        });
+    });
+});
