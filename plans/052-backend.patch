+// ============================================
+// LIBRARY SOURCES (plan 052 — NotebookLM mirror)
+// ============================================
+
+export interface LibrarySourceRow {
+    id: string;
+    collection: string;
+    source_id: string;
+    notebook_id: string | null;
+    notebook_title: string | null;
+    title: string;
+    url: string | null;
+    chars: number;
+    chunks: number;
+    content_hash: string;
+    updated_at: string;
+}
+
+const upsertLibrarySourceStmt = db.prepare(`
+    INSERT INTO library_sources (id, collection, source_id, notebook_id, notebook_title, title, url, chars, chunks, content_hash, updated_at)
+    VALUES (@id, @collection, @source_id, @notebook_id, @notebook_title, @title, @url, @chars, @chunks, @content_hash, datetime('now'))
+    ON CONFLICT(id) DO UPDATE SET
+        collection = excluded.collection, source_id = excluded.source_id,
+        notebook_id = excluded.notebook_id, notebook_title = excluded.notebook_title,
+        title = excluded.title, url = excluded.url, chars = excluded.chars, chunks = excluded.chunks,
+        content_hash = excluded.content_hash, updated_at = excluded.updated_at
+`);
+const getLibrarySourceStmt = db.prepare(`SELECT * FROM library_sources WHERE id = ?`);
+const listLibrarySourcesStmt = db.prepare(`SELECT * FROM library_sources ORDER BY collection, title`);
+const deleteLibrarySourceStmt = db.prepare(`DELETE FROM library_sources WHERE id = ?`);
+
+export function upsertLibrarySource(row: Omit<LibrarySourceRow, 'updated_at'>): void {
+    upsertLibrarySourceStmt.run(row);
+}
+
+export function getLibrarySource(id: string): LibrarySourceRow | null {
+    return (getLibrarySourceStmt.get(id) as LibrarySourceRow | undefined) ?? null;
+}
+
+export function listLibrarySources(): LibrarySourceRow[] {
+    return listLibrarySourcesStmt.all() as LibrarySourceRow[];
+}
+
+/** Removes ONE library source: its metadata row, its files row and (via FK cascade) its chunks. Derived index data only. */
+export function deleteLibrarySource(id: string): void {
+    deleteLibrarySourceStmt.run(id);
+    deleteEmbeddingsByFileStmt.run(id);
+    deleteFileStmt.run(id);
+}
+
