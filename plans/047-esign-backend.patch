--- a/ai-dashboard369-file-manager/src/routes/webhookRoutes.ts
+++ b/ai-dashboard369-file-manager/src/routes/webhookRoutes.ts
@@ -13,6 +13,7 @@
 import { Router, Request, Response } from 'express';
 import crypto from 'crypto';
 import { boardProjectMapper } from '../services/boardProjectMapper';
+import { listWorkitems, updateWorkitem } from '../stores/dwelliumStore';
 
 const router = Router();
 
@@ -108,4 +109,67 @@
     res.sendStatus(200);
 });
 
+
+/* ── Documenso e-sign callbacks (plan 047) ─────────────────────────────────
+ * Auth: Documenso sends the webhook's configured secret in the
+ * X-Documenso-Secret header — timing-safe compare against
+ * DOCUMENSO_WEBHOOK_SECRET. Secret unset → 503 (never an open sink,
+ * mirrors briefRoutes.ts). Status writes are metadata UPSERTs only.
+ */
+const DOCUMENSO_EVENT_STATUS: Record<string, string> = {
+    DOCUMENT_SIGNED: 'signed',
+    DOCUMENT_COMPLETED: 'countersigned',
+    DOCUMENT_REJECTED: 'draft',
+    DOCUMENT_CANCELLED: 'draft',
+};
+
+function documensoSecretMatches(given: unknown, expected: string): boolean {
+    if (typeof given !== 'string') return false;
+    const a = Buffer.from(given);
+    const b = Buffer.from(expected);
+    return a.length === b.length && crypto.timingSafeEqual(a, b);
+}
+
+/**
+ * POST /api/webhooks/documenso — envelope lifecycle events drive lease docStatus:
+ * DOCUMENT_SIGNED → signed; DOCUMENT_COMPLETED → countersigned;
+ * DOCUMENT_REJECTED/CANCELLED → draft. Keyed by payload.envelopeId
+ * (workitem.metadata.esign.envelopeId). Unknown events are acknowledged, not errors.
+ */
+router.post('/documenso', (req: Request, res: Response) => {
+    const expected = process.env.DOCUMENSO_WEBHOOK_SECRET;
+    if (!expected) {
+        res.status(503).json({ success: false, error: 'DOCUMENSO_WEBHOOK_SECRET not configured' });
+        return;
+    }
+    if (!documensoSecretMatches(req.headers['x-documenso-secret'], expected)) {
+        res.status(401).json({ success: false, error: 'Invalid webhook secret' });
+        return;
+    }
+    const event = String((req.body as Record<string, unknown> | undefined)?.event || '');
+    const payload = ((req.body as Record<string, any> | undefined)?.payload || {}) as Record<string, any>;
+    const envelopeId = payload.envelopeId || payload.id;
+    const nextStatus = DOCUMENSO_EVENT_STATUS[event];
+    if (!nextStatus || !envelopeId) { res.json({ success: true, ignored: true, event }); return; }
+    const lease = listWorkitems({ type: 'lease' }).find(w => (w.metadata as Record<string, any> | undefined)?.esign?.envelopeId === envelopeId);
+    if (!lease) { res.json({ success: true, updated: null, event }); return; }
+    const metadata = (lease.metadata || {}) as Record<string, any>;
+    const now = new Date().toISOString();
+    const docHistory: any[] = Array.isArray(metadata.docHistory) ? metadata.docHistory : [];
+    docHistory.push({ from: metadata.docStatus || 'sent', to: nextStatus, by: 'documenso-webhook', at: now, notes: event });
+    const updates: Record<string, any> = {
+        ...metadata,
+        docStatus: nextStatus,
+        docHistory,
+        docStatusUpdatedAt: now,
+        docStatusUpdatedBy: 'documenso-webhook',
+        esign: { ...(metadata.esign || {}), lastEvent: event, lastEventAt: now },
+    };
+    if (nextStatus === 'signed') updates.docSignedAt = now;
+    if (nextStatus === 'countersigned') { updates.countersignedAt = now; updates.countersignedBy = 'documenso-webhook'; }
+    updateWorkitem(lease.id, { metadata: updates });
+    console.log(`[Webhook] Documenso ${event} → workitem ${lease.id} docStatus=${nextStatus}`);
+    res.json({ success: true, updated: lease.id, docStatus: nextStatus });
+});
+
 export default router;
diff --git a/ai-dashboard369-file-manager/tests/esignRoutes.test.ts b/ai-dashboard369-file-manager/tests/esignRoutes.test.ts
