+describe('Dub OpenAPI drift guard', () => {
+    it('every upstream path the proxy uses exists in the published OpenAPI snapshot (tests/fixtures)', () => {
+        // eslint-disable-next-line @typescript-eslint/no-var-requires
+        const { DUB_PATHS_USED } = require('../src/routes/linkRoutes');
+        // eslint-disable-next-line @typescript-eslint/no-var-requires
+        const spec = require('./fixtures/dub-openapi-paths.json');
+        expect(spec.source).toBe('https://dub.co/openapi.json');
+        expect(spec.title).toBe('Dub API');
+        expect(spec.version).toBe('0.0.1');
+        expect(spec.servers[0].url).toBe('https://api.dub.co');
+        expect(spec.securityScheme.token).toMatchObject({ type: 'http', scheme: 'bearer' });
+        for (const p of DUB_PATHS_USED) expect(Object.keys(spec.paths)).toContain(p);
+        // The methods the proxy calls must exist on those paths.
+        expect(spec.paths['/links']).toEqual(expect.arrayContaining(['GET', 'POST']));
+        expect(spec.paths['/links/{linkId}']).toEqual(expect.arrayContaining(['PATCH', 'DELETE']));
+        expect(spec.paths['/links/bulk']).toEqual(expect.arrayContaining(['POST']));
+        expect(spec.paths['/tags']).toEqual(expect.arrayContaining(['GET', 'POST']));
+        expect(spec.paths['/domains']).toEqual(expect.arrayContaining(['GET']));
+        expect(spec.paths['/analytics']).toEqual(['GET']);
+        expect(spec.paths['/qr']).toEqual(['GET']);
+        // The analytics params the proxy sends are in the published enums.
+        expect(spec.analytics.eventEnum).toContain('clicks');
+        for (const g of ['count', 'timeseries', 'top_links']) expect(spec.analytics.groupByEnum).toContain(g);
+        for (const i of ['24h', '7d', '30d', '90d', '1y', 'mtd', 'qtd', 'ytd', 'all']) expect(spec.analytics.intervalEnum).toContain(i);
+        // Endpoints that do NOT exist upstream must never be reintroduced.
+        for (const bad of ['/links/{linkId}/qr', '/links/{linkId}/archive', '/tags/attach']) {
+            expect(Object.keys(spec.paths)).not.toContain(bad);
+        }
+    });
