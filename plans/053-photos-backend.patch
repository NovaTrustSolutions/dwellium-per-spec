@@ -0,0 +1,245 @@
+/**
+ * /api/photos — Immich Photo Vault proxy (plan 053).
+ *
+ * Env unset → 503 with needsSetup:true everywhere (never a crash); staff-gated
+ * (tenant 403, no session 401); mocked Immich → albums list/create/ensure,
+ * thumbnail passthrough with content-type, multipart upload (+ album add),
+ * search smart→metadata fallback, shared-link create/list with absolute
+ * shareUrl. Plus the Immich OpenAPI drift guard against tests/fixtures.
+ */
+import { makeApp, createTestUser, TestUser } from './helpers/harness';
+
+const ENV_KEYS = ['IMMICH_URL', 'IMMICH_API_KEY', 'IMMICH_PUBLIC_URL'] as const;
+const savedEnv: Record<string, string | undefined> = {};
+beforeAll(() => { for (const k of ENV_KEYS) savedEnv[k] = process.env[k]; });
+beforeEach(() => { for (const k of ENV_KEYS) delete process.env[k]; });
+afterAll(() => {
+    for (const k of ENV_KEYS) {
+        if (savedEnv[k] === undefined) delete process.env[k]; else process.env[k] = savedEnv[k];
+    }
+});
+
+function setImmichEnv() {
+    process.env.IMMICH_URL = 'https://office-mac.tailnet.ts.net';
+    process.env.IMMICH_API_KEY = 'immich_test_key';
+}
+
+/** Minimal fetch stub — response-shaped objects (esignRoutes.test.ts pattern). */
+function jsonResponse(body: unknown, status = 200) {
+    return {
+        ok: status >= 200 && status < 300,
+        status,
+        json: async () => body,
+        arrayBuffer: async () => new ArrayBuffer(0),
+        headers: { get: () => 'application/json' },
+    };
+}
+
+function binaryResponse(bytes: Uint8Array, contentType: string, status = 200) {
+    return {
+        ok: status >= 200 && status < 300,
+        status,
+        json: async () => { throw new Error('binary'); },
+        arrayBuffer: async () => bytes.buffer,
+        headers: { get: (h: string) => (h.toLowerCase() === 'content-type' ? contentType : null) },
+    };
+}
+
+describe('/api/photos env gate (Immich not configured)', () => {
+    let staff: TestUser;
+    beforeAll(async () => { staff = await createTestUser({ role: 'management' }); });
+
+    it('503 with needsSetup:true on every route when IMMICH_* env is unset', async () => {
+        const calls = [
+            () => makeApp().get('/api/photos/status').set('Authorization', staff.authHeader),
+            () => makeApp().get('/api/photos/albums').set('Authorization', staff.authHeader),
+            () => makeApp().post('/api/photos/albums').set('Authorization', staff.authHeader).send({ albumName: 'X' }),
+            () => makeApp().post('/api/photos/albums/ensure').set('Authorization', staff.authHeader).send({ property: 'Woodland Parc Townhomes', unit: '12B' }),
+            () => makeApp().get('/api/photos/albums/abc').set('Authorization', staff.authHeader),
+            () => makeApp().get('/api/photos/assets/abc/thumbnail').set('Authorization', staff.authHeader),
+            () => makeApp().post('/api/photos/search').set('Authorization', staff.authHeader).send({ query: 'leak' }),
+            () => makeApp().get('/api/photos/shared-links').set('Authorization', staff.authHeader),
+            () => makeApp().post('/api/photos/shared-links').set('Authorization', staff.authHeader).send({ albumId: 'a1' }),
+        ];
+        for (const call of calls) {
+            const r = await call();
+            expect(r.status).toBe(503);
+            expect(r.body.success).toBe(false);
+            expect(r.body.needsSetup).toBe(true);
+            expect(r.body.error).toMatch(/IMMICH_URL/);
+        }
+    });
+
+    it('401 without a session (authenticate runs before the env gate)', async () => {
+        const r = await makeApp().get('/api/photos/albums');
+        expect(r.status).toBe(401);
+    });
+
+    it('403 for a tenant session (staff-gated) — role checked before env', async () => {
+        const tenant = await createTestUser({ role: 'tenant' });
+        const r = await makeApp().get('/api/photos/albums').set('Authorization', tenant.authHeader);
+        expect(r.status).toBe(403);
+    });
+
+    it('maintenance role passes the gate (hits the env 503, not a 403)', async () => {
+        const tech = await createTestUser({ role: 'maintenance' });
+        const r = await makeApp().get('/api/photos/albums').set('Authorization', tech.authHeader);
+        expect(r.status).toBe(503);
+    });
+});
+
+describe('/api/photos with Immich mocked', () => {
+    let staff: TestUser;
+    const realFetch = (global as any).fetch;
+    beforeAll(async () => { staff = await createTestUser({ role: 'management' }); });
+    afterEach(() => { (global as any).fetch = realFetch; });
+
+    it('GET /albums proxies Immich GET /api/albums with x-api-key', async () => {
+        setImmichEnv();
+        const fetchMock = jest.fn(async () => jsonResponse([{ id: 'al1', albumName: 'Woodland Parc Townhomes — 12B', assetCount: 3 }]));
+        (global as any).fetch = fetchMock;
+        const r = await makeApp().get('/api/photos/albums').set('Authorization', staff.authHeader);
+        expect(r.status).toBe(200);
+        expect(r.body.data).toHaveLength(1);
+        expect(r.body.data[0].albumName).toBe('Woodland Parc Townhomes — 12B');
+        const [url, init] = fetchMock.mock.calls[0] as unknown as [string, RequestInit];
+        expect(url).toBe('https://office-mac.tailnet.ts.net/api/albums');
+        expect((init.headers as Record<string, string>)['x-api-key']).toBe('immich_test_key');
+    });
+
+    it('POST /albums/ensure reuses an existing "<Property> — <Unit>" album', async () => {
+        setImmichEnv();
+        const fetchMock = jest.fn(async () => jsonResponse([{ id: 'al1', albumName: 'Riverwood Club Apartments — 7A' }]));
+        (global as any).fetch = fetchMock;
+        const r = await makeApp().post('/api/photos/albums/ensure').set('Authorization', staff.authHeader)
+            .send({ property: 'Riverwood Club Apartments', unit: '7A' });
+        expect(r.status).toBe(200);
+        expect(r.body).toMatchObject({ created: false, data: { id: 'al1' } });
+        expect(fetchMock).toHaveBeenCalledTimes(1); // list only, no create
+    });
+
+    it('POST /albums/ensure creates the album when missing (name = "<Property> — <Unit>")', async () => {
+        setImmichEnv();
+        const fetchMock = jest.fn()
+            .mockResolvedValueOnce(jsonResponse([]))
+            .mockResolvedValueOnce(jsonResponse({ id: 'al-new', albumName: 'Woodland Parc Townhomes — 3C' }, 201));
+        (global as any).fetch = fetchMock;
+        const r = await makeApp().post('/api/photos/albums/ensure').set('Authorization', staff.authHeader)
+            .send({ property: 'Woodland Parc Townhomes', unit: '3C' });
+        expect(r.status).toBe(201);
+        expect(r.body).toMatchObject({ created: true, data: { id: 'al-new' } });
+        const [, init] = fetchMock.mock.calls[1] as unknown as [string, RequestInit];
+        expect(JSON.parse(String(init.body))).toMatchObject({ albumName: 'Woodland Parc Townhomes — 3C' });
+    });
+
+    it('GET /assets/:id/thumbnail streams bytes with the upstream content-type', async () => {
+        setImmichEnv();
+        const bytes = new Uint8Array([0xff, 0xd8, 0xff, 0xe0]); // JPEG magic
+        (global as any).fetch = jest.fn(async () => binaryResponse(bytes, 'image/jpeg'));
+        const r = await makeApp().get('/api/photos/assets/as1/thumbnail').set('Authorization', staff.authHeader);
+        expect(r.status).toBe(200);
+        expect(r.headers['content-type']).toMatch(/image\/jpeg/);
+        expect(Buffer.from(r.body).subarray(0, 4)).toEqual(Buffer.from(bytes));
+    });
+
+    it('POST /assets uploads multipart to Immich and adds to the album from ?albumId', async () => {
+        setImmichEnv();
+        const fetchMock = jest.fn()
+            .mockResolvedValueOnce(jsonResponse({ id: 'asset-1', status: 'created' }, 201))
+            .mockResolvedValueOnce(jsonResponse([{ id: 'asset-1', success: true }]));
+        (global as any).fetch = fetchMock;
+        const r = await makeApp().post('/api/photos/assets?albumId=al1').set('Authorization', staff.authHeader)
