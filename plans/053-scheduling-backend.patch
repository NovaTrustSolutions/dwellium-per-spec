diff --git a/tests/schedulingRoutes.test.ts b/tests/schedulingRoutes.test.ts
new file mode 100644
index 0000000..db93f71
--- /dev/null
+++ b/tests/schedulingRoutes.test.ts
@@ -0,0 +1,318 @@
+/**
+ * /api/scheduling + /api/webhooks/calcom (plan 053 — cal.com API v2 proxy).
+ *
+ * Env unset → 503 needsSetup:true on every proxy route (never a crash, never
+ * an open sink); configured + mocked cal.com → Bearer auth + per-endpoint
+ * cal-api-version headers; webhook is HMAC-SHA256 (x-cal-signature-256) gated
+ * and drives Task Board tasks + a communications-log notification.
+ */
+import crypto from 'crypto';
+import { makeApp, createTestUser, TestUser } from './helpers/harness';
+
+// Require AFTER harness so stores open their isolated temp SQLite.
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const taskStore = require('../src/stores/taskStore');
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const routesModule = require('../src/routes/schedulingRoutes');
+
+const ENV_KEYS = ['CALCOM_API_KEY', 'CALCOM_API_BASE', 'CALCOM_WEBHOOK_SECRET', 'CALCOM_BOOKING_URL'] as const;
+const savedEnv: Record<string, string | undefined> = {};
+beforeAll(() => { for (const k of ENV_KEYS) savedEnv[k] = process.env[k]; });
+beforeEach(() => { for (const k of ENV_KEYS) delete process.env[k]; });
+afterAll(() => {
+    for (const k of ENV_KEYS) {
+        if (savedEnv[k] === undefined) delete process.env[k]; else process.env[k] = savedEnv[k];
+    }
+});
+
+function setCalcomEnv() {
+    process.env.CALCOM_API_KEY = 'cal_test_key';
+    process.env.CALCOM_API_BASE = 'https://calapi.test/v2';
+}
+
+/** Minimal fetch stub — response-shaped objects, no undici dependency. */
+function jsonResponse(body: unknown, status = 200) {
+    return {
+        ok: status >= 200 && status < 300,
+        status,
+        json: async () => body,
+        headers: { get: () => 'application/json' },
+    };
+}
+
+/** cal.com signs the raw JSON body: HMAC-SHA256 hex with the webhook secret. */
+function sign(body: unknown, secret: string): string {
+    return crypto.createHmac('sha256', secret).update(JSON.stringify(body)).digest('hex');
+}
+
+describe('/api/scheduling env gate (cal.com not configured)', () => {
+    let mgmt: TestUser;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+
+    it('503 with needsSetup:true on every API-backed route when CALCOM_API_KEY is unset', async () => {
+        const calls = [
+            () => makeApp().get('/api/scheduling/event-types').set('Authorization', mgmt.authHeader),
+            () => makeApp().get('/api/scheduling/bookings').set('Authorization', mgmt.authHeader),
+            () => makeApp().post('/api/scheduling/bookings/uid_1/cancel').set('Authorization', mgmt.authHeader).send({}),
+        ];
+        for (const call of calls) {
+            const r = await call();
+            expect(r.status).toBe(503);
+            expect(r.body.success).toBe(false);
+            expect(r.body.needsSetup).toBe(true);
+            expect(r.body.error).toMatch(/CALCOM_API_KEY/);
+        }
+    });
+
+    it('401 without a session (authenticate runs before the env gate)', async () => {
+        const r = await makeApp().get('/api/scheduling/bookings');
+        expect(r.status).toBe(401);
+    });
+
+    it('403 for a tenant session (management-gated) — role checked before env', async () => {
+        const tenant = await createTestUser({ role: 'tenant' });
+        const r = await makeApp().get('/api/scheduling/bookings').set('Authorization', tenant.authHeader);
+        expect(r.status).toBe(403);
+    });
+
+    it('GET /link needs no API key — builds a prefilled booking link from ?base=', async () => {
+        const r = await makeApp()
+            .get('/api/scheduling/link')
