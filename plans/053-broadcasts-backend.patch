+/** Bulk UPSERT — the Strata → listmonk import bridge (plan 053). Row-by-row
+ *  upsert via the listmonk API; a failed row never aborts the batch and
+ *  NOTHING is ever deleted. */
+router.post('/subscribers/import', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const body = (req.body && typeof req.body === 'object' ? req.body : {}) as {
+        subscribers?: Array<{ email?: string; name?: string; attribs?: Record<string, unknown> }>;
+        lists?: number[]; preconfirm?: boolean;
+    };
+    const subs = Array.isArray(body.subscribers) ? body.subscribers : [];
+    const lists = Array.isArray(body.lists) ? body.lists.filter(n => Number.isInteger(n)) : [];
+    if (subs.length === 0 || lists.length === 0) {
+        res.status(400).json({ success: false, error: 'subscribers[] and at least one list id are required' });
+        return;
+    }
+    if (subs.length > 500) {
+        res.status(400).json({ success: false, error: 'max 500 subscribers per import call' });
+        return;
+    }
+    const preconfirm = body.preconfirm === true;
+    const outcome = { created: 0, updated: 0, failed: [] as Array<{ email: string; error: string }> };
+    for (const raw of subs) {
+        const email = typeof raw?.email === 'string' ? raw.email.trim().toLowerCase() : '';
+        if (!EMAIL_RE.test(email)) { outcome.failed.push({ email: email || '(missing)', error: 'invalid e-mail' }); continue; }
+        try {
+            const r = await upsertSubscriber(cfg, {
+                email,
+                name: (typeof raw?.name === 'string' && raw.name.trim()) || email,
+                lists,
+                attribs: raw?.attribs && typeof raw.attribs === 'object' ? raw.attribs : {},
+                preconfirm,
+            });
+            if (r.ok) outcome[r.action === 'created' ? 'created' : 'updated'] += 1;
+            else outcome.failed.push({ email, error: r.error });
+        } catch (err) {
+            outcome.failed.push({ email, error: (err as Error).message });
+        }
+    }
+    res.json({ success: true, data: outcome });
+});
