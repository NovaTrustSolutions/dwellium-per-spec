+/** plan 055 P4 — "Left off" label: top-z Classic window title, else the
+ *  active Holocron/Fluid tab id. Null when nothing was restored. */
+export function leftOffLabel(snap: SessionSnapshot | null): string | null {
+    if (!snap) return null;
+    const wins = snap.classic.filter(w => w && typeof w.title === 'string' && w.title);
+    if (wins.length > 0) return wins.reduce((a, b) => ((b.zIndex ?? 0) > (a.zIndex ?? 0) ? b : a)).title;
+    const tab = snap.halocron?.active ?? snap.fluid?.active;
+    return typeof tab === 'string' && tab ? tab : null;
 }
 
