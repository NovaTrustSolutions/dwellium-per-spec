diff --git a/ai-dashboard369-file-manager/tests/openaiStream.test.ts b/ai-dashboard369-file-manager/tests/openaiStream.test.ts
new file mode 100644
--- /dev/null
+++ b/ai-dashboard369-file-manager/tests/openaiStream.test.ts
@@ -0,0 +1,32 @@
+import { pumpOpenAiSse } from '../src/services/llm/openaiStream';
+
+function streamOf(chunks: string[]): ReadableStream<Uint8Array> {
+    const enc = new TextEncoder();
+    return new ReadableStream({
+        start(c) {
+            for (const ch of chunks) c.enqueue(enc.encode(ch));
+            c.close();
+        },
+    });
+}
+
+describe('pumpOpenAiSse (046-A4)', () => {
+    it('joins deltas split across chunks, reports finish_reason, stops at [DONE]', async () => {
+        const deltas: string[] = [];
+        const out = await pumpOpenAiSse(streamOf([
+            'data: {"choices":[{"delta":{"role":"assistant","content":""},"finish_reason":null}]}\n\ndata: {"choices":[{"delta":{"content":"Hel"}}]}\n\ndata: {"choi',
+            'ces":[{"delta":{"content":"lo"},"finish_reason":null}]}\n\ndata: {"choices":[{"delta":{},"finish_reason":"stop"}]}\n\ndata: [DONE]\n\ndata: {"choices":[{"delta":{"content":"IGNORED"}}]}\n\n',
+        ]), d => deltas.push(d));
+        expect(out).toEqual({ text: 'Hello', finishReason: 'stop' });
+        expect(deltas).toEqual(['Hel', 'lo']);
+    });
+
+    it('empty + length (reasoning ate the budget) is reported, not hidden', async () => {
+        const onDelta = jest.fn();
+        const out = await pumpOpenAiSse(streamOf([
+            'data: {"choices":[{"delta":{},"finish_reason":"length"}]}\r\n\r\ndata: [DONE]\r\n\r\n',
+        ]), onDelta);
+        expect(out).toEqual({ text: '', finishReason: 'length' });
+        expect(onDelta).not.toHaveBeenCalled();
+    });
+});
