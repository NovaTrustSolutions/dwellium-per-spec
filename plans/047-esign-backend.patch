diff --git a/ai-dashboard369-file-manager/src/routes/esignRoutes.ts b/ai-dashboard369-file-manager/src/routes/esignRoutes.ts
new file mode 100644
--- /dev/null
+++ b/ai-dashboard369-file-manager/src/routes/esignRoutes.ts
@@ -0,0 +1,151 @@
+/**
+ * E-Sign Routes — Documenso backend proxy (plan 047, phase 1).
+ *
+ * Mounted at /api/esign behind `authenticate` (app.ts). The browser never
+ * sees a Documenso credential: DOCUMENSO_API_URL + DOCUMENSO_API_KEY live
+ * here only. While that env is unset (no Documenso deployed yet — gate G2),
+ * every route answers 503 with a clear JSON error (`needsSetup: true`) so
+ * the frontend renders its "needs setup" state — never a crash.
+ *
+ *   GET  /api/esign/documents                       list leases sent for e-signature
+ *   GET  /api/esign/leases/:workitemId/status       one lease's e-sign metadata
+ *   POST /api/esign/leases/:workitemId/send         create + send envelope; docStatus approved→sent
+ *   GET  /api/esign/leases/:workitemId/signed-pdf   proxy the signed PDF from Documenso
+ *
+ * All routes are management-gated for phase 1; tenant-scoped signing tokens
+ * arrive with the Tenant Portal embed step (plan 047 step 5/6).
+ * Status updates flow back via POST /api/webhooks/documenso (webhookRoutes.ts).
+ */
+import { Router, Request, Response } from 'express';
+import { requireRole } from '../services/authMiddleware';
+import * as store from '../stores/dwelliumStore';
+
+const router = Router();
+
+interface DocumensoConfig { baseUrl: string; apiKey: string; }
+
+function documensoConfig(): DocumensoConfig | null {
+    const baseUrl = process.env.DOCUMENSO_API_URL;
+    const apiKey = process.env.DOCUMENSO_API_KEY;
+    if (!baseUrl || !apiKey) return null;
+    return { baseUrl: baseUrl.replace(/\/+$/, ''), apiKey };
+}
+
+/** 503 body the frontend keys its needs-setup empty state on. */
+const NOT_CONFIGURED = {
+    success: false,
+    error: 'Documenso is not configured — set DOCUMENSO_API_URL and DOCUMENSO_API_KEY on the backend',
+    needsSetup: true,
+} as const;
+
+/** Documenso v2 REST: raw `api_…` key in the Authorization header (plan 047). */
+function documensoFetch(cfg: DocumensoConfig, path: string, init?: RequestInit): Promise<globalThis.Response> {
+    return fetch(`${cfg.baseUrl}/api/v2${path}`, {
+        ...init,
+        headers: { Authorization: cfg.apiKey, 'Content-Type': 'application/json', ...((init?.headers as Record<string, string>) || {}) },
+    });
+}
+
+router.get('/documents', requireRole('management'), (_req: Request, res: Response) => {
+    if (!documensoConfig()) { res.status(503).json(NOT_CONFIGURED); return; }
+    const docs = store.listWorkitems({ type: 'lease' })
+        .filter(w => (w.metadata as Record<string, any> | undefined)?.esign?.envelopeId)
+        .map(w => {
+            const md = w.metadata as Record<string, any>;
+            return {
+                workitemId: w.id,
+                title: w.title,
+                docStatus: md.docStatus || 'sent',
+                envelopeId: md.esign.envelopeId,
+                recipients: md.esign.recipients || [],
+                sentAt: md.esign.sentAt || null,
+            };
+        });
+    res.json({ success: true, data: docs });
+});
+
+router.get('/leases/:workitemId/status', requireRole('management'), (req: Request, res: Response) => {
+    if (!documensoConfig()) { res.status(503).json(NOT_CONFIGURED); return; }
+    const w = store.getWorkitem(req.params.workitemId);
+    if (!w) { res.status(404).json({ success: false, error: 'Workitem not found' }); return; }
+    const md = (w.metadata || {}) as Record<string, any>;
+    res.json({ success: true, data: { workitemId: w.id, docStatus: md.docStatus || 'draft', esign: md.esign || null } });
+});
+
+router.post('/leases/:workitemId/send', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = documensoConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const w = store.getWorkitem(req.params.workitemId);
+    if (!w) { res.status(404).json({ success: false, error: 'Workitem not found' }); return; }
+    const metadata = (w.metadata || {}) as Record<string, any>;
+    const docStatus = metadata.docStatus || 'draft';
+    // Mirrors DOC_TRANSITIONS in dwelliumRoutes.ts: only approved → sent.
+    if (docStatus !== 'approved') {
+        res.status(400).json({ success: false, error: `Cannot send for e-signature from '${docStatus}' — approve the document first` });
+        return;
+    }
+    const body = (req.body && typeof req.body === 'object' ? req.body : {}) as { recipients?: Array<{ email: string; name?: string; role?: string }> };
+    const fallback = [{
+        email: metadata.applicantEmail || metadata.tenantEmail,
+        name: metadata.applicantName || metadata.tenantName || w.title,
+        role: 'signer',
+    }].filter(r => typeof r.email === 'string' && r.email.includes('@'));
+    const recipients = Array.isArray(body.recipients) && body.recipients.length > 0 ? body.recipients : fallback;
+    if (recipients.length === 0) {
+        res.status(400).json({ success: false, error: 'No recipient email — pass recipients[] or set applicantEmail on the lease' });
+        return;
+    }
+    try {
+        const templateId = process.env.DOCUMENSO_TEMPLATE_LEASE;
+        const createRes = await documensoFetch(cfg, '/envelopes', {
+            method: 'POST',
+            body: JSON.stringify({ title: w.title, ...(templateId ? { templateId } : {}), recipients, externalId: w.id }),
+        });
+        if (!createRes.ok) { res.status(502).json({ success: false, error: `Documenso envelope create failed (${createRes.status})` }); return; }
+        const envelope = (await createRes.json().catch(() => ({}))) as Record<string, any>;
+        const envelopeId = envelope.id ?? envelope.envelopeId;
+        if (!envelopeId) { res.status(502).json({ success: false, error: 'Documenso envelope create returned no id' }); return; }
+        const sendRes = await documensoFetch(cfg, `/envelopes/${envelopeId}/send`, { method: 'POST', body: '{}' });
+        if (!sendRes.ok) { res.status(502).json({ success: false, error: `Documenso envelope send failed (${sendRes.status})` }); return; }
+        const sendData = (await sendRes.json().catch(() => ({}))) as Record<string, any>;
+        const sentRecipients = sendData.recipients ?? envelope.recipients ?? recipients;
+
+        const actor = req.user?.email || 'management';
+        const now = new Date().toISOString();
+        const docHistory: any[] = Array.isArray(metadata.docHistory) ? metadata.docHistory : [];
+        docHistory.push({ from: docStatus, to: 'sent', by: actor, at: now, notes: 'Sent for e-signature via Documenso' });
+        store.updateWorkitem(w.id, {
+            metadata: {
+                ...metadata,
+                docStatus: 'sent',
+                docSentAt: now,
+                docStatusUpdatedAt: now,
+                docStatusUpdatedBy: actor,
+                docHistory,
+                esign: { envelopeId, recipients: sentRecipients, sentAt: now },
+            },
+        });
+        res.json({ success: true, data: { workitemId: w.id, envelopeId, recipients: sentRecipients, docStatus: 'sent' } });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `Documenso unreachable: ${(err as Error).message}` });
+    }
+});
+
+router.get('/leases/:workitemId/signed-pdf', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = documensoConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const w = store.getWorkitem(req.params.workitemId);
+    const envelopeId = (w?.metadata as Record<string, any> | undefined)?.esign?.envelopeId;
+    if (!w || !envelopeId) { res.status(404).json({ success: false, error: 'No e-sign envelope on this lease' }); return; }
+    try {
+        const upstream = await documensoFetch(cfg, `/envelopes/${envelopeId}/download`);
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `Documenso download failed (${upstream.status})` }); return; }
+        const buf = Buffer.from(await upstream.arrayBuffer());
+        res.setHeader('Content-Type', upstream.headers.get('content-type') || 'application/pdf');
+        res.send(buf);
+    } catch (err) {
+        res.status(502).json({ success: false, error: `Documenso unreachable: ${(err as Error).message}` });
+    }
+});
+
+export default router;
