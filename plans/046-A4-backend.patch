+/**
+ * POST /api/ara/chat/stream — 046-A4: same contract as /chat, streamed as SSE.
+ * `data: {"delta"}` per token, then `event: done` with the full ARAResponse
+ * (or `event: error` + {error}). Never logs userLlmKey.
+ */
+router.post('/chat/stream', async (req: Request, res: Response) => {
+    const { mode, message, sessionId, jurisdiction, workspaceContext, humanize, userLlmKey } = req.body;
+
+    if (!mode || !message) {
+        res.status(400).json({ success: false, error: 'mode and message are required' });
+        return;
+    }
+
+    if (!getMode(mode)) {
+        res.status(400).json({ success: false, error: `Invalid mode: ${mode}` });
+        return;
+    }
+
+    res.setHeader('Content-Type', 'text/event-stream');
+    res.setHeader('Cache-Control', 'no-cache');
+    res.setHeader('Connection', 'keep-alive');
+    res.setHeader('X-Accel-Buffering', 'no');
+    res.flushHeaders();
+
+    try {
+        const response = await chatWithARA(mode, message, sessionId, jurisdiction, workspaceContext, {
+            humanize: humanize === true,
+            userLlmKey: userLlmKey?.provider === 'openai' && typeof userLlmKey?.apiKey === 'string'
+                ? { provider: 'openai', apiKey: userLlmKey.apiKey, model: typeof userLlmKey.model === 'string' ? userLlmKey.model : undefined }
+                : undefined,
+            onDelta: (delta) => { res.write(`data: ${JSON.stringify({ delta })}\n\n`); },
+        });
+        res.write(`event: done\ndata: ${JSON.stringify(response)}\n\n`);
+    } catch (err) {
+        console.error('[ARA Route] Chat stream error:', err);
+        res.write(`event: error\ndata: ${JSON.stringify({ error: err instanceof Error ? err.message : 'Chat failed' })}\n\n`);
+    }
+    res.end();
 });
 
