+/**
+ * /api/links — Dub short-link proxy (plan 047 phase 2).
+ *
+ * Env unset → 503 with needsSetup:true (never a crash); 401 without a session;
+ * 403 for tenants (management-gated). With DUB_API_KEY set + fetch mocked:
+ * POST creates a link with Bearer auth and UPSERTs it into external_links
+ * (UNIQUE(tool, external_type, external_id) — re-create updates, never
+ * duplicates, never deletes); GET lists links with click counts.
+ */
+import { makeApp, createTestUser, TestUser } from './helpers/harness';
+
+// Require AFTER harness so the DB opens in the isolated temp dir.
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { database: db } = require('../src/services/database');
+
+const ENV_KEYS = ['DUB_API_KEY', 'DUB_WORKSPACE', 'DUB_API_BASE'] as const;
+const savedEnv: Record<string, string | undefined> = {};
+beforeAll(() => { for (const k of ENV_KEYS) savedEnv[k] = process.env[k]; });
+beforeEach(() => { for (const k of ENV_KEYS) delete process.env[k]; });
+afterAll(() => {
+    for (const k of ENV_KEYS) {
+        if (savedEnv[k] === undefined) delete process.env[k]; else process.env[k] = savedEnv[k];
+    }
+});
+
+function setDubEnv() {
+    process.env.DUB_API_KEY = 'dub_test_key';
+    process.env.DUB_API_BASE = 'https://dub.test';
+}
+
+function jsonResponse(body: unknown, status = 200) {
+    return {
+        ok: status >= 200 && status < 300,
+        status,
+        json: async () => body,
+        headers: { get: () => 'application/json' },
+    };
+}
+
+function externalLinkRows(externalId: string): Array<Record<string, any>> {
+    return db.prepare(
+        "SELECT * FROM external_links WHERE tool = 'dub' AND external_type = 'link' AND external_id = ?",
+    ).all(externalId);
+}
+
+describe('/api/links env gate (Dub not configured)', () => {
+    let mgmt: TestUser;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+
+    it('503 with needsSetup:true on both routes when DUB_API_KEY is unset', async () => {
+        const calls = [
+            () => makeApp().get('/api/links').set('Authorization', mgmt.authHeader),
+            () => makeApp().post('/api/links').set('Authorization', mgmt.authHeader).send({ url: 'https://example.com' }),
+        ];
+        for (const call of calls) {
+            const r = await call();
+            expect(r.status).toBe(503);
+            expect(r.body.success).toBe(false);
+            expect(r.body.needsSetup).toBe(true);
+            expect(r.body.error).toMatch(/DUB_API_KEY/);
+        }
+    });
+
+    it('401 without a session (authenticate runs before the env gate)', async () => {
+        const r = await makeApp().get('/api/links');
+        expect(r.status).toBe(401);
+    });
+
+    it('403 for a tenant session (management-gated) — role checked before env', async () => {
+        const tenant = await createTestUser({ role: 'tenant' });
+        const r = await makeApp().get('/api/links').set('Authorization', tenant.authHeader);
+        expect(r.status).toBe(403);
+    });
+});
+
+describe('/api/links (Dub mocked)', () => {
+    let mgmt: TestUser;
+    const realFetch = (global as any).fetch;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+    afterEach(() => { (global as any).fetch = realFetch; });
+
+    it('POST / creates a short link with Bearer auth and UPSERTs into external_links', async () => {
+        setDubEnv();
+        const seen: Array<{ url: string; auth: string; body: Record<string, any> }> = [];
+        (global as any).fetch = async (url: unknown, init?: { headers?: Record<string, string>; body?: string }) => {
+            seen.push({ url: String(url), auth: init?.headers?.Authorization || '', body: JSON.parse(init?.body || '{}') });
+            return jsonResponse({ id: 'link_abc', shortLink: 'https://dub.sh/notice1', url: 'https://example.com/notice', key: 'notice1', clicks: 0, qrCode: 'https://api.dub.co/qr?url=https%3A%2F%2Fdub.sh%2Fnotice1' });
+        };
+        const r = await makeApp().post('/api/links').set('Authorization', mgmt.authHeader)
+            .send({ url: 'https://example.com/notice', key: 'notice1', entityType: 'unit', entityId: '2B' });
+        expect(r.status).toBe(201);
+        expect(r.body.data).toMatchObject({ id: 'link_abc', shortLink: 'https://dub.sh/notice1', clicks: 0 });
+        expect(r.body.data.qrCode).toMatch(/\/qr\?url=/);
+        expect(seen).toHaveLength(1);
+        expect(seen[0].url).toBe('https://dub.test/links');
+        expect(seen[0].auth).toBe('Bearer dub_test_key');
+        expect(seen[0].body).toMatchObject({ url: 'https://example.com/notice', key: 'notice1', externalId: 'unit:2B' });
+
+        const rows = externalLinkRows('link_abc');
+        expect(rows).toHaveLength(1);
+        expect(rows[0]).toMatchObject({ tool: 'dub', entity_type: 'unit', entity_id: '2B', external_url: 'https://dub.sh/notice1' });
+
+        // Same Dub id again → UPSERT updates the one row (never a duplicate).
+        const again = await makeApp().post('/api/links').set('Authorization', mgmt.authHeader)
+            .send({ url: 'https://example.com/notice', key: 'notice1' });
+        expect(again.status).toBe(201);
+        expect(externalLinkRows('link_abc')).toHaveLength(1);
+    });
+
+    it('POST / appends workspaceId when DUB_WORKSPACE is set', async () => {
+        setDubEnv();
+        process.env.DUB_WORKSPACE = 'ws_dwellium';
+        const urls: string[] = [];
+        (global as any).fetch = async (url: unknown) => {
+            urls.push(String(url));
+            return jsonResponse({ id: 'link_ws', shortLink: 'https://dub.sh/x', url: 'https://example.com', key: 'x', clicks: 0 });
+        };
+        const r = await makeApp().post('/api/links').set('Authorization', mgmt.authHeader).send({ url: 'https://example.com' });
+        expect(r.status).toBe(201);
+        expect(urls[0]).toBe('https://dub.test/links?workspaceId=ws_dwellium');
+    });
+
+    it('POST / with a bad url → 400, Dub never called', async () => {
+        setDubEnv();
+        let called = 0;
+        (global as any).fetch = async () => { called += 1; return jsonResponse({}); };
+        const r = await makeApp().post('/api/links').set('Authorization', mgmt.authHeader).send({ url: 'notaurl' });
+        expect(r.status).toBe(400);
+        expect(called).toBe(0);
+    });
+
+    it('GET / lists links with click counts (array and {links:[…]} shapes)', async () => {
+        setDubEnv();
+        (global as any).fetch = async () => jsonResponse([
+            { id: 'link_1', shortLink: 'https://dub.sh/a', url: 'https://example.com/a', key: 'a', clicks: 12 },
+            { id: 'link_2', shortLink: 'https://dub.sh/b', url: 'https://example.com/b', key: 'b', clicks: 3 },
+        ]);
+        const r = await makeApp().get('/api/links').set('Authorization', mgmt.authHeader);
+        expect(r.status).toBe(200);
+        expect(r.body.data).toHaveLength(2);
+        expect(r.body.data[0]).toMatchObject({ id: 'link_1', clicks: 12 });
+        expect(r.body.data[0].qrCode).toContain('/qr?url=');
+        // Mirrored upsert-only — the listed links land in external_links too.
+        expect(externalLinkRows('link_1')).toHaveLength(1);
+
+        (global as any).fetch = async () => jsonResponse({ links: [{ id: 'link_3', shortLink: 'https://dub.sh/c', url: 'https://example.com/c', key: 'c', clicks: 1 }] });
+        const wrapped = await makeApp().get('/api/links').set('Authorization', mgmt.authHeader);
+        expect(wrapped.status).toBe(200);
+        expect(wrapped.body.data).toEqual([expect.objectContaining({ id: 'link_3', clicks: 1 })]);
+    });
+
+    it('Dub 500 → 502; unreachable (fetch throws) → 502', async () => {
+        setDubEnv();
+        (global as any).fetch = async () => jsonResponse({ error: 'boom' }, 500);
+        expect((await makeApp().get('/api/links').set('Authorization', mgmt.authHeader)).status).toBe(502);
+        (global as any).fetch = async () => { throw new Error('ECONNREFUSED'); };
+        const r = await makeApp().post('/api/links').set('Authorization', mgmt.authHeader).send({ url: 'https://example.com' });
+        expect(r.status).toBe(502);
+        expect(r.body.error).toMatch(/unreachable/);
+    });
+});
