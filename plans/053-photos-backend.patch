-        return origin.toLowerCase();
-    }
-}
-
-function parseOriginList(raw?: string): string[] {
-    if (!raw) return [];
-    return raw
-        .split(',')
-        .map(v => v.trim())
-        .filter(Boolean)
-        .map(normalizeOrigin);
-}
