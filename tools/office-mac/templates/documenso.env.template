# Documenso .env — generated by tools/office-mac/bootstrap.sh. Placeholders only;
# real values land in tools/documenso/.env (gitignored). Conventions from
# tools/documenso/README.md: secrets via openssl rand -hex 32, port 3140 via the
# local override, mailpit catches all outbound mail (UI http://127.0.0.1:8025).
POSTGRES_USER=documenso
POSTGRES_PASSWORD=__DBPASS__
POSTGRES_DB=documenso
NEXTAUTH_SECRET=__GENERATE__
NEXT_PRIVATE_ENCRYPTION_KEY=__GENERATE__
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=__GENERATE__
# Switch to the Funnel URL (https://<mac>.<tailnet>.ts.net:8443) once Tailscale
# is up — signing emails carry this base URL, so residents need it reachable.
NEXT_PUBLIC_WEBAPP_URL=http://127.0.0.1:3140
NEXT_PRIVATE_DATABASE_URL=postgresql://documenso:__DBPASS__@database:5432/documenso
# mailpit (from docker-compose.override.yml) — no SMTP account needed.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp
NEXT_PRIVATE_SMTP_HOST=mailpit
NEXT_PRIVATE_SMTP_PORT=1025
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=true
NEXT_PRIVATE_SMTP_FROM_NAME=Dwellium E-Sign
NEXT_PRIVATE_SMTP_FROM_ADDRESS=esign@dwellium.com
# Passphrase for the self-signed signing cert (bootstrap generates cert.p12
# with this exact value — regenerate both together or neither).
NEXT_PRIVATE_SIGNING_PASSPHRASE=__GENERATE__
