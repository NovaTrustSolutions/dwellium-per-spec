+        expect(seen[0].auth).toBe('token dwellium:tok_test');
+    });
+
+    it('GET /campaigns unwraps results; GET /templates handles flat data arrays', async () => {
+        setListmonkEnv();
+        (global as any).fetch = async (url: unknown) =>
+            String(url).includes('/templates')
+                ? jsonResponse({ data: [{ id: 2, name: 'Notice' }] })
+                : jsonResponse({ data: { results: [{ id: 7, name: 'August notice', status: 'draft' }] } });
+        const camps = await makeApp().get('/api/broadcasts/campaigns').set('Authorization', mgmt.authHeader);
+        expect(camps.status).toBe(200);
+        expect(camps.body.data[0]).toMatchObject({ id: 7, status: 'draft' });
+        const tpls = await makeApp().get('/api/broadcasts/templates').set('Authorization', mgmt.authHeader);
+        expect(tpls.status).toBe(200);
+        expect(tpls.body.data).toEqual([{ id: 2, name: 'Notice' }]);
+    });
+
+    it('POST /campaigns creates a DRAFT from template + audience (201, type regular)', async () => {
+        setListmonkEnv();
+        const bodies: Record<string, any>[] = [];
+        (global as any).fetch = async (_url: unknown, init?: { body?: string }) => {
+            bodies.push(JSON.parse(init?.body || '{}'));
+            return jsonResponse({ data: { id: 42, name: 'Pool closure', status: 'draft' } });
+        };
+        const r = await makeApp().post('/api/broadcasts/campaigns').set('Authorization', mgmt.authHeader)
+            .send({ name: 'Pool closure', subject: 'Pool closed Friday', lists: [1, 3], template_id: 2 });
+        expect(r.status).toBe(201);
+        expect(r.body.data).toMatchObject({ id: 42, status: 'draft' });
+        expect(bodies).toHaveLength(1);
+        expect(bodies[0]).toMatchObject({
+            name: 'Pool closure',
+            subject: 'Pool closed Friday',
+            lists: [1, 3],
+            type: 'regular',
+            template_id: 2,
+        });
+    });
+
+    it('POST /campaigns without subject or lists → 400, listmonk never called', async () => {
+        setListmonkEnv();
+        let called = 0;
+        (global as any).fetch = async () => { called += 1; return jsonResponse({}); };
+        const noSubject = await makeApp().post('/api/broadcasts/campaigns').set('Authorization', mgmt.authHeader).send({ lists: [1] });
+        expect(noSubject.status).toBe(400);
+        const noLists = await makeApp().post('/api/broadcasts/campaigns').set('Authorization', mgmt.authHeader).send({ subject: 'Hi', lists: [] });
