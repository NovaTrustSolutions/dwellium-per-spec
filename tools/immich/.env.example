# Dwellium Photo Vault — Immich .env for the office Mac.
# Copy this file to `.env` in the same folder and edit the three values below.
# (Based on the official example.env from the Immich v3.1.0 release.)

# Where photos/videos are stored on the Mac disk. Create the folder first.
UPLOAD_LOCATION=/Users/andy/DwelliumPhotos/library

# Where the Postgres database lives. Keep it on the Mac's internal SSD
# (Immich: never a network share). Create the folder first.
DB_DATA_LOCATION=/Users/andy/DwelliumPhotos/postgres

# Postgres password — make up a random one. LETTERS AND NUMBERS ONLY
# (A-Za-z0-9, no spaces or symbols — Immich requirement).
DB_PASSWORD=CHANGE-ME-alphanumeric-only

# Optional: uncomment and set the office timezone (TZ identifier list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List)
# TZ=America/Los_Angeles

# The Immich version to run. "v3" tracks the v3.x line; pin e.g. "v3.1.0" to freeze.
IMMICH_VERSION=v3

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
