+// plan 055 P4 — "Left off" line from the synced One Save session-restore object.
+describe('Left off line (plan 055 P4)', () => {
+    it('adds "Left off: <top-z window title>" when a session-restore object exists', () => {
+        seedUser('u3');
+        upsertObject({ id: 'session-restore_u3', type: 'session-restore', ownerId: 'u3', payload: {
+            version: 1,
+            classic: [
+                { component: 'notepad', title: 'Notepad', icon: '', x: 0, y: 0, width: 1, height: 1, zIndex: 3, minimized: false },
+                { component: 'scribe', title: 'Scribe', icon: '', x: 0, y: 0, width: 1, height: 1, zIndex: 9, minimized: false },
+            ],
+            halocron: { tabs: [], active: null },
+            fluid: { tabs: [], active: null },
+            savedAt: Date.now(),
+        } });
+        const lines = buildDataLines(readUserObjects('u3')!);
+        expect(lines).toContain('Left off: Scribe');
+    });
+
+    it('falls back to the active Holocron tab and stays silent when nothing is restored', () => {
+        seedUser('u4');
+        upsertObject({ id: 'session-restore_u4', type: 'session-restore', ownerId: 'u4', payload: {
+            version: 1, classic: [], halocron: { tabs: ['strata-dashboard'], active: 'strata-dashboard' }, fluid: { tabs: [], active: null }, savedAt: 1,
+        } });
+        expect(buildDataLines(readUserObjects('u4')!)).toContain('Left off: strata-dashboard');
+
+        seedUser('u5'); // no session-restore object at all
+        expect(buildDataLines(readUserObjects('u5')!).some(l => l.startsWith('Left off'))).toBe(false);
+    });
+
+    it('tolerates a corrupt session-restore payload (no line, no throw)', () => {
