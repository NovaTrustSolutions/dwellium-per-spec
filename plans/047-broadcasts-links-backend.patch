+
+describe('/api/broadcasts (listmonk mocked)', () => {
+    let mgmt: TestUser;
+    const realFetch = (global as any).fetch;
+    beforeAll(async () => { mgmt = await createTestUser({ role: 'management' }); });
+    afterEach(() => { (global as any).fetch = realFetch; });
+
+    it('GET /lists proxies with the token header and unwraps paginated results', async () => {
