+
+    it('injects the Library section into the system prompt and pushes library chips', async () => {
+        const res = await chatWithARA('executive-assistant', LEASE_Q, `lib-${Date.now()}`);
+        expect(res.content).toBe('Sixty days, per the lease.');
+        expect(systemPrompts.length).toBeGreaterThan(0);
+        expect(systemPrompts[0]).toContain(`## ${LIBRARY_SECTION_TITLE}`);
+        expect(systemPrompts[0]).toContain('### [Woodland Parc Lease]');
+        expect(res.contextSources).toEqual(expect.arrayContaining([{ name: 'Woodland Parc Lease', type: 'library', itemCount: 1 }]));
+        expect(res.contextSources.filter((s: any) => s.type === 'library')).toHaveLength(1);
+    });
+
+    it('adds no section and no chips when nothing in the Library matches', async () => {
+        const res = await chatWithARA('executive-assistant', 'zebra migration patterns in the serengeti', `lib-none-${Date.now()}`);
+        expect(systemPrompts[0]).not.toContain(LIBRARY_SECTION_TITLE);
+        expect((res.contextSources || []).some((s: any) => s.type === 'library')).toBe(false);
+    });
+});
