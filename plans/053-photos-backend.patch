+function normalizeOrigin(origin: string): string {
+    try {
+        const parsed = new URL(origin);
+        return `${parsed.protocol}//${parsed.host}`.toLowerCase();
+    } catch {
+        return origin.toLowerCase();
+    }
+}
+
+function parseOriginList(raw?: string): string[] {
+    if (!raw) return [];
+    return raw
+        .split(',')
+        .map(v => v.trim())
+        .filter(Boolean)
+        .map(normalizeOrigin);
+}
+
+const configuredOrigins = parseOriginList(process.env.CORS_ORIGINS || process.env.CORS_ORIGIN);
+const devOrigins = [
+    'http://localhost:5173',
+    'http://127.0.0.1:5173',
+    'http://localhost:4173',
+    'http://127.0.0.1:4173',
+    'http://localhost:3000',
+    'http://127.0.0.1:3000',
+].map(normalizeOrigin);
+const allowedOriginSet = new Set<string>([
+    ...configuredOrigins,
+    ...(!isProduction ? devOrigins : []),
+]);
+const hasExplicitCorsOrigins = configuredOrigins.length > 0;
+
+if (isProduction && process.env.AUTH_ENABLED !== 'true' && process.env.ALLOW_INSECURE_AUTH_BYPASS_IN_PRODUCTION !== 'true') {
+    throw new Error('Refusing to start in production with AUTH_ENABLED=false. Set AUTH_ENABLED=true or explicitly override with ALLOW_INSECURE_AUTH_BYPASS_IN_PRODUCTION=true.');
+}
+if (isProduction && !hasExplicitCorsOrigins) {
+    console.warn('[Security] No CORS_ORIGINS configured in production. Browser clients will be blocked by secure CORS defaults.');
+}
+
+const corsOptions: CorsOptions = {
+    origin: (origin, callback) => {
+        // Allow server-to-server/curl/no-origin requests.
+        if (!origin) return callback(null, true);
+
+        const normalized = normalizeOrigin(origin);
+        if (allowedOriginSet.has(normalized)) return callback(null, true);
+
+        // Secure default for production: require an explicit allowlist.
+        if (isProduction) {
+            return callback(new Error(`CORS origin not allowed: ${origin}`));
+        }
+
+        // Development fallback: permit localhost origins even if env not set.
+        if (!hasExplicitCorsOrigins && (normalized.includes('localhost') || normalized.includes('127.0.0.1'))) {
+            return callback(null, true);
+        }
+
+        return callback(new Error(`CORS origin not allowed: ${origin}`));
+    },
+    methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],
