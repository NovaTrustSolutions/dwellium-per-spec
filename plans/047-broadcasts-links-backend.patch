diff --git a/ai-dashboard369-file-manager/src/routes/broadcastRoutes.ts b/ai-dashboard369-file-manager/src/routes/broadcastRoutes.ts
new file mode 100644
index 0000000..a9bf9be
--- /dev/null
+++ b/ai-dashboard369-file-manager/src/routes/broadcastRoutes.ts
@@ -0,0 +1,171 @@
+/**
+ * Broadcast Routes — listmonk backend proxy (plan 047, phase 2).
+ *
+ * Mounted at /api/broadcasts behind `authenticate` (app.ts). The browser never
+ * sees a listmonk credential: LISTMONK_URL + LISTMONK_USER + LISTMONK_TOKEN
+ * live here only (the listmonk itself runs on the free e2-micro —
+ * tools/listmonk/README.md in the frontend repo). While that env is unset,
+ * every route answers 503 with `needsSetup: true` so the frontend renders its
+ * "needs setup" card — never a crash.
+ *
+ *   GET  /api/broadcasts/lists                mailing lists (audiences)
+ *   GET  /api/broadcasts/templates            campaign templates
+ *   GET  /api/broadcasts/campaigns            recent campaigns with status
+ *   POST /api/broadcasts/campaigns            create a DRAFT campaign from a template + audience
+ *   POST /api/broadcasts/campaigns/:id/test   send the draft to test addresses
+ *
+ * All routes are management-gated. Only fixed listmonk paths are proxied —
+ * never a caller-supplied URL. Drafts are created, never auto-started;
+ * starting/scheduling a real send stays in the listmonk admin for now.
+ * listmonk auth: `Authorization: token api_user:token` (listmonk.app/docs/apis/apis/).
+ */
+import { Router, Request, Response } from 'express';
+import { requireRole } from '../services/authMiddleware';
+
+const router = Router();
+
+interface ListmonkConfig { baseUrl: string; user: string; token: string; }
+
+function listmonkConfig(): ListmonkConfig | null {
+    const baseUrl = process.env.LISTMONK_URL;
+    const user = process.env.LISTMONK_USER;
+    const token = process.env.LISTMONK_TOKEN;
+    if (!baseUrl || !user || !token) return null;
+    return { baseUrl: baseUrl.replace(/\/+$/, ''), user, token };
+}
+
+/** 503 body the frontend keys its needs-setup empty state on. */
+const NOT_CONFIGURED = {
+    success: false,
+    error: 'listmonk is not configured — set LISTMONK_URL, LISTMONK_USER and LISTMONK_TOKEN on the backend',
+    needsSetup: true,
+} as const;
+
+function listmonkFetch(cfg: ListmonkConfig, path: string, init?: RequestInit): Promise<globalThis.Response> {
+    return fetch(`${cfg.baseUrl}/api${path}`, {
+        ...init,
+        headers: {
+            Authorization: `token ${cfg.user}:${cfg.token}`,
+            'Content-Type': 'application/json',
+            ...((init?.headers as Record<string, string>) || {}),
+        },
+    });
+}
+
+/** listmonk paginated endpoints answer {data:{results:[…]}}; flat ones {data:[…]}. */
+function resultsOf(body: unknown): unknown[] {
+    const data = (body as Record<string, any> | null)?.data;
+    if (Array.isArray(data)) return data;
+    if (Array.isArray(data?.results)) return data.results;
+    return [];
+}
+
+router.get('/lists', requireRole('management'), async (_req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const upstream = await listmonkFetch(cfg, '/lists?page=1&per_page=100');
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `listmonk lists failed (${upstream.status})` }); return; }
+        res.json({ success: true, data: resultsOf(await upstream.json().catch(() => null)) });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `listmonk unreachable: ${(err as Error).message}` });
+    }
+});
+
+router.get('/templates', requireRole('management'), async (_req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const upstream = await listmonkFetch(cfg, '/templates');
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `listmonk templates failed (${upstream.status})` }); return; }
+        res.json({ success: true, data: resultsOf(await upstream.json().catch(() => null)) });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `listmonk unreachable: ${(err as Error).message}` });
+    }
+});
+
+router.get('/campaigns', requireRole('management'), async (_req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const upstream = await listmonkFetch(cfg, '/campaigns?page=1&per_page=50&order_by=created_at&order=DESC');
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `listmonk campaigns failed (${upstream.status})` }); return; }
+        res.json({ success: true, data: resultsOf(await upstream.json().catch(() => null)) });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `listmonk unreachable: ${(err as Error).message}` });
+    }
+});
+
+/** Create a DRAFT campaign (never started here) from a template + audience. */
+router.post('/campaigns', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const body = (req.body && typeof req.body === 'object' ? req.body : {}) as {
+        name?: string; subject?: string; lists?: number[]; template_id?: number; body?: string; content_type?: string;
+    };
+    const lists = Array.isArray(body.lists) ? body.lists.filter(n => Number.isInteger(n)) : [];
+    const subject = typeof body.subject === 'string' ? body.subject.trim() : '';
+    if (!subject || lists.length === 0) {
+        res.status(400).json({ success: false, error: 'subject and at least one list id are required' });
+        return;
+    }
+    try {
+        const upstream = await listmonkFetch(cfg, '/campaigns', {
+            method: 'POST',
+            body: JSON.stringify({
+                name: (typeof body.name === 'string' && body.name.trim()) || subject,
+                subject,
+                lists,
+                type: 'regular',
+                content_type: typeof body.content_type === 'string' ? body.content_type : 'richtext',
+                body: typeof body.body === 'string' ? body.body : '',
+                ...(Number.isInteger(body.template_id) ? { template_id: body.template_id } : {}),
+            }),
+        });
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `listmonk campaign create failed (${upstream.status})` }); return; }
+        const created = (await upstream.json().catch(() => ({}))) as Record<string, any>;
+        res.status(201).json({ success: true, data: created.data ?? created });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `listmonk unreachable: ${(err as Error).message}` });
+    }
+});
+
+/** Send a draft to test addresses (listmonk POST /campaigns/:id/test wants the
+ *  campaign fields again alongside `subscribers` — re-read them upstream). */
+router.post('/campaigns/:id/test', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const id = Number.parseInt(req.params.id, 10);
+    if (!Number.isInteger(id)) { res.status(400).json({ success: false, error: 'Numeric campaign id required' }); return; }
+    const body = (req.body && typeof req.body === 'object' ? req.body : {}) as { subscribers?: string[] };
+    const subscribers = (Array.isArray(body.subscribers) ? body.subscribers : [])
+        .filter(s => typeof s === 'string' && s.includes('@'));
+    if (subscribers.length === 0) {
+        res.status(400).json({ success: false, error: 'subscribers[] with at least one email is required' });
+        return;
+    }
+    try {
+        const getRes = await listmonkFetch(cfg, `/campaigns/${id}`);
+        if (!getRes.ok) { res.status(502).json({ success: false, error: `listmonk campaign fetch failed (${getRes.status})` }); return; }
+        const campaign = ((await getRes.json().catch(() => ({}))) as Record<string, any>).data ?? {};
+        const testRes = await listmonkFetch(cfg, `/campaigns/${id}/test`, {
+            method: 'POST',
+            body: JSON.stringify({
+                name: campaign.name,
+                subject: campaign.subject,
+                lists: Array.isArray(campaign.lists) ? campaign.lists.map((l: Record<string, any>) => l?.id ?? l) : [],
+                type: campaign.type || 'regular',
+                content_type: campaign.content_type || 'richtext',
+                body: campaign.body || '',
+                ...(campaign.template_id ? { template_id: campaign.template_id } : {}),
+                subscribers,
+            }),
+        });
+        if (!testRes.ok) { res.status(502).json({ success: false, error: `listmonk test send failed (${testRes.status})` }); return; }
+        res.json({ success: true, data: { sent: subscribers } });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `listmonk unreachable: ${(err as Error).message}` });
+    }
+});
+
+export default router;
diff --git a/ai-dashboard369-file-manager/src/routes/linkRoutes.ts b/ai-dashboard369-file-manager/src/routes/linkRoutes.ts
new file mode 100644
index 0000000..46571cb
--- /dev/null
+++ b/ai-dashboard369-file-manager/src/routes/linkRoutes.ts
@@ -0,0 +1,155 @@
+/**
+ * Link Routes — Dub short-link backend proxy (plan 047, phase 2).
+ *
+ * Mounted at /api/links behind `authenticate` (app.ts). The browser never sees
+ * the Dub credential: DUB_API_KEY lives here only (dub.co free plan per the
+ * plan-047 addendum — ~25 links/mo, QR + API included). While the key is
+ * unset, every route answers 503 with `needsSetup: true`.
+ *
+ *   POST /api/links     create a short link (optional custom key) — returns shortLink + qrCode URL
+ *   GET  /api/links     list links with click counts
+ *
+ * Management-gated. Every created link is UPSERTed into the `external_links`
+ * SQLite table (dwelliumSchema.ts) keyed by UNIQUE(tool, external_type,
+ * external_id) — rows are never deleted (archive = soft flag in metadata).
+ * Dub API: Bearer auth against https://api.dub.co; QR PNG is served
+ * unauthenticated at GET {base}/qr?url=… (dub.co/docs/api-reference).
+ */
+import { Router, Request, Response } from 'express';
+import { randomUUID } from 'crypto';
+import { requireRole } from '../services/authMiddleware';
+import { database as db } from '../services/database';
+
+const router = Router();
+
+interface DubConfig { apiBase: string; apiKey: string; workspace?: string; }
+
+function dubConfig(): DubConfig | null {
+    const apiKey = process.env.DUB_API_KEY;
+    if (!apiKey) return null;
+    return {
+        apiBase: (process.env.DUB_API_BASE || 'https://api.dub.co').replace(/\/+$/, ''),
+        apiKey,
+        workspace: process.env.DUB_WORKSPACE || undefined,
+    };
+}
+
+/** 503 body the frontend keys its needs-setup empty state on. */
+const NOT_CONFIGURED = {
+    success: false,
+    error: 'Dub is not configured — set DUB_API_KEY (and optionally DUB_WORKSPACE) on the backend',
+    needsSetup: true,
+} as const;
+
+function dubFetch(cfg: DubConfig, path: string, init?: RequestInit): Promise<globalThis.Response> {
+    // Tokens are workspace-scoped; pass workspaceId explicitly when configured.
+    const sep = path.includes('?') ? '&' : '?';
+    const url = `${cfg.apiBase}${path}${cfg.workspace ? `${sep}workspaceId=${encodeURIComponent(cfg.workspace)}` : ''}`;
+    return fetch(url, {
+        ...init,
+        headers: {
+            Authorization: `Bearer ${cfg.apiKey}`,
+            'Content-Type': 'application/json',
+            ...((init?.headers as Record<string, string>) || {}),
+        },
+    });
+}
+
+interface LinkRow {
+    id: string;
+    shortLink: string;
+    url: string;
+    key: string;
+    clicks: number;
+    qrCode: string;
+    entityType?: string | null;
+    entityId?: string | null;
+}
+
+function toLinkRow(cfg: DubConfig, raw: Record<string, any>): LinkRow {
+    const shortLink = raw.shortLink || '';
+    return {
+        id: String(raw.id ?? ''),
+        shortLink,
+        url: raw.url || '',
+        key: raw.key || '',
+        clicks: typeof raw.clicks === 'number' ? raw.clicks : 0,
+        // Dub returns a hosted qrCode URL on the link object; fall back to the
+        // unauthenticated QR endpoint for older shapes.
+        qrCode: raw.qrCode || `${cfg.apiBase}/qr?url=${encodeURIComponent(shortLink)}`,
+    };
+}
+
+const ENTITY_TYPES = new Set(['property', 'unit', 'resident', 'lease', 'vendor', 'workitem', 'doc']);
+
+/** UPSERT-only mirror into external_links — never DELETE (repo data rule). */
+function upsertExternalLink(row: LinkRow, entityType?: string, entityId?: string): void {
+    db.prepare(`
+        INSERT INTO external_links (id, tool, entity_type, entity_id, external_type, external_id, external_url, metadata)
+        VALUES (?, 'dub', ?, ?, 'link', ?, ?, ?)
+        ON CONFLICT(tool, external_type, external_id) DO UPDATE SET
+            external_url = excluded.external_url,
+            entity_type = COALESCE(excluded.entity_type, external_links.entity_type),
+            entity_id = COALESCE(excluded.entity_id, external_links.entity_id),
+            metadata = excluded.metadata,
+            updated_at = datetime('now')
+    `).run(
+        randomUUID(),
+        entityType && ENTITY_TYPES.has(entityType) ? entityType : null,
+        entityId || null,
+        row.id,
+        row.shortLink,
+        JSON.stringify({ url: row.url, key: row.key, clicks: row.clicks, qrCode: row.qrCode }),
+    );
+}
+
+router.post('/', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = dubConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const body = (req.body && typeof req.body === 'object' ? req.body : {}) as {
+        url?: string; key?: string; entityType?: string; entityId?: string;
+    };
+    const url = typeof body.url === 'string' ? body.url.trim() : '';
+    if (!/^https?:\/\/\S+$/i.test(url)) {
+        res.status(400).json({ success: false, error: 'A valid http(s) url is required' });
+        return;
+    }
+    try {
+        const upstream = await dubFetch(cfg, '/links', {
+            method: 'POST',
+            body: JSON.stringify({
+                url,
+                ...(typeof body.key === 'string' && body.key.trim() ? { key: body.key.trim() } : {}),
+                ...(body.entityType && body.entityId ? { externalId: `${body.entityType}:${body.entityId}` } : {}),
+            }),
+        });
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `Dub link create failed (${upstream.status})` }); return; }
+        const raw = (await upstream.json().catch(() => ({}))) as Record<string, any>;
+        if (!raw.id) { res.status(502).json({ success: false, error: 'Dub link create returned no id' }); return; }
+        const row = toLinkRow(cfg, raw);
+        upsertExternalLink(row, body.entityType, body.entityId);
+        res.status(201).json({ success: true, data: row });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `Dub unreachable: ${(err as Error).message}` });
+    }
+});
+
+router.get('/', requireRole('management'), async (_req: Request, res: Response) => {
+    const cfg = dubConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const upstream = await dubFetch(cfg, '/links?page=1&pageSize=100');
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `Dub link list failed (${upstream.status})` }); return; }
+        const body = (await upstream.json().catch(() => null)) as unknown;
+        const rawLinks: Record<string, any>[] = Array.isArray(body)
+            ? body
+            : Array.isArray((body as Record<string, any> | null)?.links) ? (body as Record<string, any>).links : [];
+        const rows = rawLinks.filter(l => l && l.id).map(l => toLinkRow(cfg, l));
+        for (const row of rows) upsertExternalLink(row); // keep click counts mirrored, upsert-only
+        res.json({ success: true, data: rows });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `Dub unreachable: ${(err as Error).message}` });
+    }
+});
+
+export default router;
