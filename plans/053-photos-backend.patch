+        registerProcessErrorHandlers();
+
+        // ── Stella Auto-Init ──────────────────────────────────────────
+        // Automatically connect to Stella (CoPaw) on startup so she's
+        // ready to go when the user opens the Stella widget.
+        (async () => {
+            try {
+                const { initStella } = require('./services/stellaService');
+                const state = await initStella();
+                if (state.status === 'online') {
+                    console.log(`[Stella] ✅ Online — ${state.version || 'connected'} (${state.lastHealthCheckMs}ms, PID ${state.pid || '?'})`);
+                } else {
+                    console.log(`[Stella] ⚠️ Not reachable at startup (status: ${state.status}). Will retry via health monitor.`);
+                }
+            } catch (err: any) {
+                console.warn(`[Stella] Auto-init failed: ${err.message}. Start CoPaw manually or it will be detected when it comes online.`);
+            }
+        })();
+    });
+}
+
+export default app;
