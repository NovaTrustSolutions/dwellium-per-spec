+ * Isolated temp DWELLIUM_DATA_DIR (set before any src require); `openai` replaced by a deterministic fake.
+ */
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+
+jest.mock('openai', () => require('./helpers/fakeOpenAI').fakeOpenAIModule());
+
+const TMP = fs.mkdtempSync(path.join(os.tmpdir(), 'dwellium-library-'));
+process.env.DWELLIUM_DATA_DIR = TMP;
+process.env.QUALIA_DATA_DIR = TMP;
+process.env.ONE_SAVE_DATA_DIR = path.join(TMP, 'onesave');
+process.env.SEED_DEMO_DATA = 'false';
+process.env.OPENAI_API_KEY = 'sk-test-library';
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { indexFile, upsertLibrarySource } = require('../src/services/database');
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { indexText } = require('../src/services/vectorStore');
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { buildLibraryContext, chatWithARA, LIBRARY_SECTION_TITLE } = require('../src/agents/araChatEngine');
+
+afterAll(() => { fs.rmSync(TMP, { recursive: true, force: true }); });
+
+async function seed(collection: string, sourceId: string, title: string, text: string) {
+    const id = `library:${collection}:${sourceId}`;
+    indexFile({ id, path: id, name: title, type: 'library', size: text.length, projectId: null, projectName: null, summary: null, embeddingId: null, syncedAt: null, syncSource: 'notebooklm' });
+    const { chunksIndexed } = await indexText(id, title, text);
+    upsertLibrarySource({ id, collection, source_id: sourceId, notebook_id: null, notebook_title: null, title, url: null, chars: text.length, chunks: chunksIndexed, content_hash: 'h-' + sourceId });
