--- /dev/null
+++ b/src/routes/schedulingRoutes.ts
@@ -0,0 +1,310 @@
+/**
+ * Scheduling Routes — cal.com API v2 proxy + webhook (plan 053).
+ *
+ * Proxy mounted at /api/scheduling behind `authenticate` (app.ts); the browser
+ * never sees the cal.com credential: CALCOM_API_KEY (+ CALCOM_API_BASE,
+ * default https://api.cal.com/v2) live here only. While the key is unset,
+ * every proxy route answers 503 `needsSetup: true` (mirrors esignRoutes.ts).
+ *
+ *   GET  /api/scheduling/event-types              list event types (?username=)
+ *   GET  /api/scheduling/bookings                 list bookings (?status=upcoming|past|cancelled|recurring|unconfirmed,
+ *                                                 ?afterStart=&beforeEnd=&attendeeEmail=&eventTypeId=&cursor=&take=)
+ *   POST /api/scheduling/bookings/:uid/cancel     cancel one booking ({ reason })
+ *   GET  /api/scheduling/link                     build a prefilled booking link (?base=&slug=&name=&email= — no API key needed)
+ *
+ * Upstream calls — verified against cal.com's published API v2 docs
+ * (record of the exact pages used, all fetched 2026-08-23):
+ *   https://cal.com/docs/api-reference/v2/introduction.md                     auth = `Authorization: Bearer <cal_… key>`; 120 req/min
+ *   https://cal.com/docs/api-reference/v2/event-types/get-all-event-types.md  GET /v2/event-types, header cal-api-version: 2024-06-14
+ *   https://cal.com/docs/api-reference/v2/bookings/get-all-bookings.md        GET /v2/bookings, header cal-api-version: 2026-05-01,
+ *                                                                             filters status/attendeeEmail/eventTypeId/afterStart/beforeEnd/cursor/take
+ *   https://cal.com/docs/api-reference/v2/bookings/cancel-a-booking.md        POST /v2/bookings/{bookingUid}/cancel, header cal-api-version: 2026-02-25,
+ *                                                                             body { cancellationReason }
+ *   https://cal.com/docs/api-reference/v2/openapi.json                        snapshot in tests/fixtures/calcom-v2-paths.json (drift guard)
+ *   https://cal.com/docs/developing/guides/appstore-and-integration/how-to-show-assigned-people-from-a-crm.md
+ *                                                                             booking-page prefill via ?email= (and sister ?name=) query params
+ *
+ * Webhook — `calcomWebhookRouter`, mounted at /api/webhooks/calcom WITHOUT
+ * `authenticate` (external caller); verified instead via HMAC-SHA256 of the raw
+ * request body with CALCOM_WEBHOOK_SECRET compared against the
+ * `x-cal-signature-256` header, per
+ * https://cal.com/docs/developing/guides/automation/webhooks.md
+ * ("Verifying the authenticity of the received payload"). Secret unset → 503
+ * (never an open sink). BOOKING_CREATED / BOOKING_RESCHEDULED /
+ * BOOKING_CANCELLED drive a Task Board task (taskStore), a Google Calendar
+ * entry (calendarService, best-effort) and a communications-log notification
+ * (dwelliumStore.createComm). Unknown events are acknowledged and ignored.
+ */
+import { Router, Request, Response } from 'express';
+import crypto from 'crypto';
+import { requireRole } from '../services/authMiddleware';
+import { getTasks, createTask, updateTaskStatus } from '../stores/taskStore';
+import { createCalendarEvent } from '../services/calendarService';
+import { getAuthStrategy } from '../services/googleAuth';
+import { createComm } from '../stores/dwelliumStore';
+
+const router = Router();
+
+/** Every upstream path this proxy uses (OpenAPI path templates) — asserted by tests/schedulingRoutes.test.ts. */
+export const CALCOM_PATHS_USED = [
+    '/v2/event-types',
+    '/v2/bookings',
+    '/v2/bookings/{bookingUid}/cancel',
+] as const;
+
+/** Per-endpoint `cal-api-version` header values (each endpoint doc pins its own) — asserted against the fixture. */
+export const CALCOM_API_VERSIONS: Record<(typeof CALCOM_PATHS_USED)[number], string> = {
+    '/v2/event-types': '2024-06-14',
+    '/v2/bookings': '2026-05-01',
+    '/v2/bookings/{bookingUid}/cancel': '2026-02-25',
+};
+
+interface CalcomConfig { baseUrl: string; apiKey: string; }
+
+function calcomConfig(): CalcomConfig | null {
+    const apiKey = process.env.CALCOM_API_KEY;
+    if (!apiKey) return null;
+    const baseUrl = (process.env.CALCOM_API_BASE || 'https://api.cal.com/v2').replace(/\/+$/, '');
+    return { baseUrl, apiKey };
+}
+
+/** 503 body the frontend keys its needs-setup empty state on. */
+const NOT_CONFIGURED = {
+    success: false,
+    error: 'cal.com is not configured — set CALCOM_API_KEY on the backend (cal.com → Settings → Security → API keys)',
+    needsSetup: true,
+} as const;
+
+/** "?a=b" when the params are non-empty, "" otherwise. */
+function qsSuffix(qs: URLSearchParams): string {
+    const s = qs.toString();
+    return s ? `?${s}` : '';
+}
+
+/** JSON call against the cal.com v2 API — Bearer key + per-endpoint cal-api-version. */
+function calcomFetch(cfg: CalcomConfig, apiPath: string, apiVersion: string, init?: RequestInit): Promise<globalThis.Response> {
+    return fetch(`${cfg.baseUrl}${apiPath}`, {
+        ...init,
+        headers: {
+            Authorization: `Bearer ${cfg.apiKey}`,
+            'cal-api-version': apiVersion,
+            'Content-Type': 'application/json',
+            ...((init?.headers as Record<string, string>) || {}),
+        },
+    });
+}
+
+async function relay(res: Response, upstream: globalThis.Response): Promise<void> {
+    let body: unknown = null;
+    try { body = await upstream.json(); } catch { /* empty upstream body */ }
+    if (!upstream.ok) {
+        res.status(502).json({ success: false, error: `cal.com answered ${upstream.status}`, upstream: body });
+        return;
+    }
+    res.json({ success: true, data: (body as { data?: unknown })?.data ?? body });
+}
+
+/**
+ * Build a prefilled cal.com booking link: <base>/<slug>?name=&email=&notes=.
+ * Prefill via query params per the cal.com CRM guide (?email=…); exported for tests.
+ */
+export function buildBookingLink(base: string, slug: string, prefill: { name?: string; email?: string; notes?: string } = {}): string {
+    const trimmedBase = base.trim().replace(/\/+$/, '');
+    const url = new URL(slug ? `${trimmedBase}/${slug.replace(/^\/+/, '')}` : trimmedBase);
+    if (prefill.name) url.searchParams.set('name', prefill.name);
+    if (prefill.email) url.searchParams.set('email', prefill.email);
+    if (prefill.notes) url.searchParams.set('notes', prefill.notes);
+    return url.toString();
+}
+
+router.get('/event-types', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = calcomConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const qs = new URLSearchParams();
+    if (typeof req.query.username === 'string' && req.query.username) qs.set('username', req.query.username);
+    try {
+        const upstream = await calcomFetch(cfg, `/event-types${qsSuffix(qs)}`, CALCOM_API_VERSIONS['/v2/event-types']);
+        await relay(res, upstream);
+    } catch (err) {
+        res.status(502).json({ success: false, error: `cal.com unreachable: ${err instanceof Error ? err.message : String(err)}` });
+    }
+});
+
+const BOOKING_STATUSES = ['upcoming', 'recurring', 'past', 'cancelled', 'unconfirmed'] as const;
+
+router.get('/bookings', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = calcomConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const qs = new URLSearchParams();
+    const status = typeof req.query.status === 'string' ? req.query.status : '';
+    if (status && !(BOOKING_STATUSES as readonly string[]).includes(status)) {
+        res.status(400).json({ success: false, error: `status must be one of ${BOOKING_STATUSES.join(', ')}` });
+        return;
+    }
+    if (status) qs.set('status', status);
+    for (const key of ['afterStart', 'beforeEnd', 'attendeeEmail', 'eventTypeId', 'cursor', 'take'] as const) {
+        const v = req.query[key];
+        if (typeof v === 'string' && v) qs.set(key, v);
+    }
+    try {
+        const upstream = await calcomFetch(cfg, `/bookings${qsSuffix(qs)}`, CALCOM_API_VERSIONS['/v2/bookings']);
+        await relay(res, upstream);
+    } catch (err) {
+        res.status(502).json({ success: false, error: `cal.com unreachable: ${err instanceof Error ? err.message : String(err)}` });
+    }
+});
+
+router.post('/bookings/:uid/cancel', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = calcomConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const reason = typeof req.body?.reason === 'string' && req.body.reason.trim() ? req.body.reason.trim() : 'Cancelled from Dwellium';
+    try {
+        const upstream = await calcomFetch(
+            cfg,
+            `/bookings/${encodeURIComponent(req.params.uid)}/cancel`,
+            CALCOM_API_VERSIONS['/v2/bookings/{bookingUid}/cancel'],
+            { method: 'POST', body: JSON.stringify({ cancellationReason: reason }) },
+        );
+        await relay(res, upstream);
+    } catch (err) {
+        res.status(502).json({ success: false, error: `cal.com unreachable: ${err instanceof Error ? err.message : String(err)}` });
+    }
+});
+
+router.get('/link', requireRole('management'), (req: Request, res: Response) => {
+    const base = typeof req.query.base === 'string' && req.query.base.trim()
+        ? req.query.base : (process.env.CALCOM_BOOKING_URL || '');
+    if (!base) {
+        res.status(400).json({ success: false, error: 'Pass ?base=https://cal.com/<user> (or set CALCOM_BOOKING_URL)' });
+        return;
+    }
+    const slug = typeof req.query.slug === 'string' ? req.query.slug : '';
+    try {
+        const link = buildBookingLink(base, slug, {
+            name: typeof req.query.name === 'string' ? req.query.name : undefined,
+            email: typeof req.query.email === 'string' ? req.query.email : undefined,
+            notes: typeof req.query.notes === 'string' ? req.query.notes : undefined,
+        });
+        res.json({ success: true, data: { link } });
+    } catch {
+        res.status(400).json({ success: false, error: 'base is not a valid URL' });
+    }
+});
+
+export default router;
+
+/* ── cal.com webhook (POST /api/webhooks/calcom) ─────────────────────────── */
+
+export const calcomWebhookRouter = Router();
+
+/** HMAC-SHA256 hex of the raw body with the secret must equal x-cal-signature-256 (timing-safe). */
+function calcomSignatureMatches(rawBody: Buffer | undefined, given: unknown, secret: string): boolean {
+    if (!rawBody || typeof given !== 'string' || !given) return false;
+    const expected = crypto.createHmac('sha256', secret).update(rawBody).digest('hex');
+    const a = Buffer.from(given);
+    const b = Buffer.from(expected);
+    return a.length === b.length && crypto.timingSafeEqual(a, b);
+}
+
+/** "Showing:" unless the event-type slug says otherwise — Andy's four event types (plan 053). */
+export function bookingTaskLabel(eventSlug: string | undefined): string {
+    const slug = (eventSlug || '').toLowerCase();
+    if (slug.includes('maintenance')) return 'Maintenance window';
+    if (slug.includes('vendor')) return 'Vendor visit';
+    if (slug.includes('walkthrough') || slug.includes('move')) return 'Walkthrough';
+    return 'Showing';
+}
+
+interface CalcomBookingPayload {
+    uid?: string;
+    rescheduleUid?: string;
+    title?: string;
+    type?: string; // event-type slug
+    startTime?: string;
+    endTime?: string;
+    attendees?: Array<{ name?: string; email?: string }>;
+    cancellationReason?: string;
+}
+
+const HANDLED_EVENTS = ['BOOKING_CREATED', 'BOOKING_RESCHEDULED', 'BOOKING_CANCELLED'] as const;
+
+function findTaskByBookingUid(uid: string) {
+    return getTasks().find(t => t.sourceItemId === `calcom:${uid}`);
+}
+
+calcomWebhookRouter.post('/', async (req: Request, res: Response) => {
+    const secret = process.env.CALCOM_WEBHOOK_SECRET;
+    if (!secret) {
+        res.status(503).json({ success: false, error: 'CALCOM_WEBHOOK_SECRET not configured' });
+        return;
+    }
+    const rawBody = (req as Request & { rawBody?: Buffer }).rawBody;
+    if (!calcomSignatureMatches(rawBody, req.headers['x-cal-signature-256'], secret)) {
+        res.status(401).json({ success: false, error: 'Invalid x-cal-signature-256 signature' });
+        return;
+    }
+
+    try {
+        const event = String(req.body?.triggerEvent || '');
+        if (!(HANDLED_EVENTS as readonly string[]).includes(event)) {
+            res.json({ success: true, ignored: true, event });
+            return;
+        }
+
+        const p: CalcomBookingPayload = req.body?.payload || {};
+        const uid = String(p.uid || '');
+        if (!uid) { res.status(400).json({ success: false, error: 'payload.uid missing' }); return; }
+        const who = p.attendees?.[0]?.name || p.attendees?.[0]?.email || 'Unknown booker';
+        const when = p.startTime || 'unknown time';
+        const label = bookingTaskLabel(p.type);
+        const title = `${label}: ${who} — ${when}`;
+
+        let taskId: string | null = null;
+        if (event === 'BOOKING_CANCELLED') {
+            const existing = findTaskByBookingUid(uid);
+            if (existing) { updateTaskStatus(existing.id, 'done'); taskId = existing.id; }
+        } else {
+            // RESCHEDULED carries a NEW uid + rescheduleUid of the old booking — close the old task, open the new one.
+            if (event === 'BOOKING_RESCHEDULED' && p.rescheduleUid) {
+                const old = findTaskByBookingUid(String(p.rescheduleUid));
+                if (old) updateTaskStatus(old.id, 'done');
+            }
+            const existing = findTaskByBookingUid(uid);
+            taskId = existing?.id ?? createTask({
+                title,
+                description: `${p.title || label} · ${p.startTime || '?'} → ${p.endTime || '?'} · booked via cal.com (${uid})`,
+                projectId: 'leasing',
+                urgency: 'medium',
+                source: 'manual',
+                sourceItemId: `calcom:${uid}`,
+            }).id;
+        }
+
+        // Calendar entry — best-effort through the existing Google Calendar service
+        // (cal.com may also sync directly when Andy connects his calendar there).
+        // Only attempted when Google auth is actually configured, and never from
+        // tests — no accidental writes to a real calendar.
+        let calendar = false;
+        if (event !== 'BOOKING_CANCELLED' && p.startTime && p.endTime
+            && getAuthStrategy() !== 'none' && process.env.NODE_ENV !== 'test') {
+            try {
+                await createCalendarEvent({ summary: title, description: `Booked via cal.com (${uid})`, start: p.startTime, end: p.endTime });
+                calendar = true;
+            } catch { /* Google Calendar not connected — the Task Board task still records it */ }
+        }
+
+        // Notification — communications log (channel CHECK allows email|phone|sms|portal|internal).
+        createComm({
+            channel: 'internal',
+            direction: 'inbound',
+            fromAddress: 'calcom-webhook',
+            subject: event === 'BOOKING_CANCELLED' ? `Cancelled — ${title}` : title,
+            body: `${event}: ${p.title || label} for ${who} at ${when}${p.cancellationReason ? ` (reason: ${p.cancellationReason})` : ''}`,
+        });
+
+        res.json({ success: true, event, taskId, calendar });
+    } catch (err) {
+        console.error('[Webhook] cal.com handler error:', err);
+        res.status(500).json({ success: false, error: 'cal.com webhook handling failed' });
+    }
+});
