+            // Seed default widget/section permissions after users exist
+            const { seedDefaultPermissions } = require('./services/permissionsService');
+            seedDefaultPermissions();
+        }).catch(err => console.error('[Auth] User seeding failed:', err.message));
+
+        // Initialize asset schema (P1 tables: asset_registry, inventory, saved_views)
+        // try { initAssetSchema(); } catch (err: any) { console.error('[Schema] Asset schema failed:', err.message); }
