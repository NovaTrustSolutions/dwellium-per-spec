index 0000000..6e65615
--- /dev/null
+++ b/src/routes/photoRoutes.ts
@@ -0,0 +1,335 @@
+/**
+ * Photo Routes — Immich backend proxy (plan 053, Photo Vault to 100 %).
+ *
+ * Mounted at /api/photos behind `authenticate` (app.ts). The browser never
+ * sees an Immich credential: IMMICH_URL + IMMICH_API_KEY live here only.
+ * While that env is unset (Immich not stood up on the office Mac yet),
+ * every route answers 503 with `needsSetup: true` so the frontend renders
+ * its "needs setup" state — never a crash. All routes are staff-gated
+ * (`requireRole('maintenance')` = maintenance and above; tenants 403).
+ *
+ *   GET  /api/photos/status                     ping Immich (/server/ping) → { ok, reachable }
+ *   GET  /api/photos/albums                     list albums (Immich GET /albums)
+ *   POST /api/photos/albums                     create album { albumName, description? }
+ *   POST /api/photos/albums/ensure              find-or-create by { property, unit } → "<Property> — <Unit>"
+ *   GET  /api/photos/albums/:id                 one album incl. assets (Immich GET /albums/{id})
+ *   PUT  /api/photos/albums/:id/assets          add assets { ids } (Immich PUT /albums/{id}/assets)
+ *   GET  /api/photos/assets/:id/thumbnail       stream the thumbnail (content-type passthrough)
+ *   POST /api/photos/assets                     multipart upload (field `assetData`; ?albumId= adds to album)
+ *   POST /api/photos/search                     { query, mode?: 'smart'|'metadata', ... } → assets
+ *   GET  /api/photos/shared-links               list shared links (adds absolute shareUrl)
+ *   POST /api/photos/shared-links               create ALBUM link { albumId, expiresAt?, password?, allowUpload?, allowDownload? }
+ *
+ * Upstream calls — verified against Immich's published OpenAPI (v3.1.0,
+ * https://raw.githubusercontent.com/immich-app/immich/c98c20e9639257187e1e3b2efa9f1a7f3b465a9d/open-api/immich-openapi-specs.json,
+ * snapshot in tests/fixtures/immich-openapi-paths.json; the drift-guard test
+ * fails if any path below disappears from the spec). Auth = API key in the
+ * `x-api-key` header (securitySchemes.api_key, in: header, name: x-api-key).
+ * Immich serves its API under `${IMMICH_URL}/api`.
+ *
+ * Smart search (`/search/smart`) needs the immich-machine-learning container
+ * (tools/immich/docker-compose.yml ships it commented out) — the /search route
+ * falls back to `/search/metadata` when smart search errors, so search still
+ * works with ML off (filename/EXIF only, stated in the response's `mode`).
+ */
+import { Router, Request, Response } from 'express';
+import multer from 'multer';
+import { requireRole } from '../services/authMiddleware';
+
+const router = Router();
+
+/** Every upstream path this proxy uses (OpenAPI path templates) — asserted by tests/photoRoutes.test.ts. */
+export const IMMICH_PATHS_USED = [
+    '/server/ping',
+    '/albums',
+    '/albums/{id}',
+    '/albums/{id}/assets',
+    '/assets',
+    '/assets/{id}/thumbnail',
+    '/search/smart',
+    '/search/metadata',
+    '/shared-links',
+] as const;
+
+interface ImmichConfig { baseUrl: string; apiKey: string; }
+
+function immichConfig(): ImmichConfig | null {
+    const baseUrl = process.env.IMMICH_URL;
+    const apiKey = process.env.IMMICH_API_KEY;
+    if (!baseUrl || !apiKey) return null;
+    return { baseUrl: baseUrl.replace(/\/+$/, ''), apiKey };
+}
+
+/** 503 body the frontend keys its needs-setup empty state on. */
+const NOT_CONFIGURED = {
+    success: false,
+    error: 'Immich is not configured — set IMMICH_URL and IMMICH_API_KEY on the backend (tools/immich/README.md)',
+    needsSetup: true,
+} as const;
+
+/** Album naming convention (plan 053): one album per unit, "<Property> — <Unit>". */
+export function albumNameFor(property: string, unit?: string | null): string {
+    const p = String(property || '').trim();
+    const u = String(unit || '').trim();
+    return u ? `${p} — ${u}` : p;
+}
+
+/** Immich API call — `${IMMICH_URL}/api` + path, x-api-key auth. */
+function immich(cfg: ImmichConfig, apiPath: string, init?: RequestInit): Promise<globalThis.Response> {
+    return fetch(`${cfg.baseUrl}/api${apiPath}`, {
+        ...init,
+        headers: { 'x-api-key': cfg.apiKey, ...((init?.headers as Record<string, string>) || {}) },
+    });
+}
+
+function immichJson(cfg: ImmichConfig, apiPath: string, init?: RequestInit): Promise<globalThis.Response> {
+    return immich(cfg, apiPath, {
+        ...init,
+        headers: { 'Content-Type': 'application/json', ...((init?.headers as Record<string, string>) || {}) },
+    });
+}
+
+/** Uniform upstream-error relay: 502 for network failures, upstream status otherwise. */
+function relayError(res: Response, err: unknown): void {
+    res.status(502).json({ success: false, error: `Immich unreachable: ${err instanceof Error ? err.message : String(err)}` });
+}
+
+async function relayUpstream(res: Response, r: globalThis.Response): Promise<void> {
+    const body = await r.json().catch(() => null);
+    res.status(r.status).json({ success: false, error: (body as { message?: string } | null)?.message || `Immich answered ${r.status}` });
+}
+
+/** Absolute share URL for a shared link (Immich serves /share/{key}). */
+function shareUrl(cfg: ImmichConfig, link: { key?: string; slug?: string }): string | null {
+    const publicBase = (process.env.IMMICH_PUBLIC_URL || cfg.baseUrl).replace(/\/+$/, '');
+    if (link.slug) return `${publicBase}/s/${link.slug}`;
+    if (link.key) return `${publicBase}/share/${link.key}`;
+    return null;
+}
+
+// All /api/photos routes are staff-only (maintenance and above).
+router.use(requireRole('maintenance'));
+
+// ── Status ──────────────────────────────────────────────────────────────────
+router.get('/status', async (_req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const r = await immich(cfg, '/server/ping');
+        res.json({ success: true, data: { reachable: r.ok } });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+// ── Albums ──────────────────────────────────────────────────────────────────
+router.get('/albums', async (_req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const r = await immich(cfg, '/albums');
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        res.json({ success: true, data: await r.json() });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+router.post('/albums', async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const albumName = String(req.body?.albumName || '').trim();
+    if (!albumName) { res.status(400).json({ success: false, error: 'albumName is required' }); return; }
+    try {
+        const r = await immichJson(cfg, '/albums', {
+            method: 'POST',
+            body: JSON.stringify({ albumName, description: req.body?.description ? String(req.body.description) : undefined }),
+        });
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        res.status(201).json({ success: true, data: await r.json() });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+/** Find-or-create the unit album for { property, unit } (never duplicates). */
+router.post('/albums/ensure', async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const property = String(req.body?.property || '').trim();
+    if (!property) { res.status(400).json({ success: false, error: 'property is required' }); return; }
+    const name = albumNameFor(property, req.body?.unit);
+    try {
+        const list = await immich(cfg, '/albums');
+        if (!list.ok) { await relayUpstream(res, list); return; }
+        const albums = (await list.json()) as Array<{ id: string; albumName: string }>;
+        const existing = albums.find(a => a.albumName === name);
+        if (existing) { res.json({ success: true, data: existing, created: false }); return; }
+        const r = await immichJson(cfg, '/albums', { method: 'POST', body: JSON.stringify({ albumName: name }) });
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        res.status(201).json({ success: true, data: await r.json(), created: true });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+router.get('/albums/:id', async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const r = await immich(cfg, `/albums/${encodeURIComponent(req.params.id)}`);
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        res.json({ success: true, data: await r.json() });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+router.put('/albums/:id/assets', async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const ids = Array.isArray(req.body?.ids) ? req.body.ids.map(String) : [];
+    if (!ids.length) { res.status(400).json({ success: false, error: 'ids[] is required' }); return; }
+    try {
+        const r = await immichJson(cfg, `/albums/${encodeURIComponent(req.params.id)}/assets`, {
+            method: 'PUT',
+            body: JSON.stringify({ ids }),
+        });
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        res.json({ success: true, data: await r.json() });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+// ── Assets ──────────────────────────────────────────────────────────────────
+/** Thumbnail passthrough — streams bytes with the upstream content-type. */
+router.get('/assets/:id/thumbnail', async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const size = req.query.size === 'preview' || req.query.size === 'fullsize' ? String(req.query.size) : 'thumbnail';
+    try {
+        const r = await immich(cfg, `/assets/${encodeURIComponent(req.params.id)}/thumbnail?size=${size}`);
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        res.status(200);
+        res.setHeader('Content-Type', r.headers.get('content-type') || 'application/octet-stream');
+        res.setHeader('Cache-Control', 'private, max-age=3600');
+        const buf = Buffer.from(await r.arrayBuffer());
+        res.end(buf);
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+// Browser → proxy → Immich upload. Memory storage: photos cap at 50 MB and are
+// forwarded immediately — nothing ever touches the backend disk.
+const upload = multer({ storage: multer.memoryStorage(), limits: { fileSize: 50 * 1024 * 1024 } });
+
+router.post('/assets', upload.single('assetData'), async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const file = req.file;
+    if (!file) { res.status(400).json({ success: false, error: 'No file uploaded (multipart field `assetData`)' }); return; }
+    const now = new Date().toISOString();
+    try {
+        // AssetMediaCreateDto (required: assetData, fileCreatedAt, fileModifiedAt).
+        const form = new FormData();
+        form.append('assetData', new Blob([new Uint8Array(file.buffer)], { type: file.mimetype || 'application/octet-stream' }), file.originalname);
+        form.append('filename', file.originalname);
+        form.append('fileCreatedAt', String(req.body?.fileCreatedAt || now));
+        form.append('fileModifiedAt', String(req.body?.fileModifiedAt || now));
+        // fetch sets the multipart boundary; never force Content-Type here.
+        const r = await immich(cfg, '/assets', { method: 'POST', body: form });
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        const created = (await r.json()) as { id: string; status?: string };
+        const albumId = String(req.query.albumId || req.body?.albumId || '').trim();
+        if (albumId && created?.id) {
+            // Best-effort: a failed album-add still leaves the asset uploaded.
+            await immichJson(cfg, `/albums/${encodeURIComponent(albumId)}/assets`, {
+                method: 'PUT',
+                body: JSON.stringify({ ids: [created.id] }),
+            }).catch(() => undefined);
+        }
+        res.status(201).json({ success: true, data: created });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+// ── Search ──────────────────────────────────────────────────────────────────
+router.post('/search', async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const query = String(req.body?.query || '').trim();
+    if (!query) { res.status(400).json({ success: false, error: 'query is required' }); return; }
+    const albumIds = Array.isArray(req.body?.albumIds) ? req.body.albumIds.map(String) : undefined;
+    const size = Math.min(Number(req.body?.size) || 60, 200);
+    try {
+        if (req.body?.mode !== 'metadata') {
+            // Smart (CLIP) search first — needs the ML container.
+            const smart = await immichJson(cfg, '/search/smart', {
+                method: 'POST',
+                body: JSON.stringify({ query, albumIds, size }),
+            });
+            if (smart.ok) {
+                const body = (await smart.json()) as { assets?: { items?: unknown[] } };
+                res.json({ success: true, mode: 'smart', data: body?.assets?.items ?? [] });
+                return;
+            }
+            if (req.body?.mode === 'smart') { await relayUpstream(res, smart); return; }
+            // fall through: ML off → metadata search below
+        }
+        const meta = await immichJson(cfg, '/search/metadata', {
+            method: 'POST',
+            body: JSON.stringify({ originalFileName: query, albumIds, size }),
+        });
+        if (!meta.ok) { await relayUpstream(res, meta); return; }
+        const body = (await meta.json()) as { assets?: { items?: unknown[] } };
+        res.json({ success: true, mode: 'metadata', data: body?.assets?.items ?? [] });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+// ── Shared links ────────────────────────────────────────────────────────────
+router.get('/shared-links', async (_req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    try {
+        const r = await immich(cfg, '/shared-links');
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        const links = (await r.json()) as Array<{ key?: string; slug?: string }>;
+        res.json({ success: true, data: links.map(l => ({ ...l, shareUrl: shareUrl(cfg, l) })) });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+router.post('/shared-links', async (req: Request, res: Response) => {
+    const cfg = immichConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const albumId = String(req.body?.albumId || '').trim();
+    if (!albumId) { res.status(400).json({ success: false, error: 'albumId is required' }); return; }
+    try {
+        const r = await immichJson(cfg, '/shared-links', {
+            method: 'POST',
+            body: JSON.stringify({
+                type: 'ALBUM',
+                albumId,
+                expiresAt: req.body?.expiresAt ? String(req.body.expiresAt) : undefined,
+                password: req.body?.password ? String(req.body.password) : undefined,
+                allowUpload: Boolean(req.body?.allowUpload),
+                allowDownload: req.body?.allowDownload === undefined ? true : Boolean(req.body.allowDownload),
+                showMetadata: req.body?.showMetadata === undefined ? true : Boolean(req.body.showMetadata),
+                description: req.body?.description ? String(req.body.description) : undefined,
+            }),
+        });
+        if (!r.ok) { await relayUpstream(res, r); return; }
+        const link = (await r.json()) as { key?: string; slug?: string };
+        res.status(201).json({ success: true, data: { ...link, shareUrl: shareUrl(cfg, link) } });
+    } catch (err) {
+        relayError(res, err);
+    }
+});
+
+export default router;
