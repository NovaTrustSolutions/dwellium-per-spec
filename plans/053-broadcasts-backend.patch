+        name?: string; type?: string; optin?: string; description?: string; tags?: string[];
+    };
+    const name = typeof body.name === 'string' ? body.name.trim() : '';
+    if (!name) { res.status(400).json({ success: false, error: 'name is required' }); return; }
+    try {
+        const upstream = await listmonkFetch(cfg, '/lists', {
+            method: 'POST',
+            body: JSON.stringify({
+                name,
+                type: body.type === 'public' ? 'public' : 'private',
+                optin: body.optin === 'double' ? 'double' : 'single',
+                ...(typeof body.description === 'string' ? { description: body.description } : {}),
+                ...(Array.isArray(body.tags) ? { tags: body.tags.filter(t => typeof t === 'string') } : {}),
+            }),
+        });
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `listmonk list create failed (${upstream.status})` }); return; }
+        const created = (await upstream.json().catch(() => ({}))) as Record<string, any>;
+        res.status(201).json({ success: true, data: created.data ?? created });
