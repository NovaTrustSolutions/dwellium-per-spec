+/** Change campaign status. 'scheduled' and 'running' start REAL sends, so they
+ *  require an explicit `confirm:true` in the body — a UI bug can never
+ *  mass-email (plan 053). 'paused'/'cancelled' stop mail and need no confirm. */
+router.put('/campaigns/:id/status', requireRole('management'), async (req: Request, res: Response) => {
+    const cfg = listmonkConfig();
+    if (!cfg) { res.status(503).json(NOT_CONFIGURED); return; }
+    const id = Number.parseInt(req.params.id, 10);
+    if (!Number.isInteger(id)) { res.status(400).json({ success: false, error: 'Numeric campaign id required' }); return; }
+    const body = (req.body && typeof req.body === 'object' ? req.body : {}) as { status?: string; confirm?: boolean };
+    const status = typeof body.status === 'string' ? body.status : '';
+    if (!CAMPAIGN_STATUSES.includes(status)) {
