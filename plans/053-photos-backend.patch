-const corsOptions: CorsOptions = {
-    origin: (origin, callback) => {
-        // Allow server-to-server/curl/no-origin requests.
-        if (!origin) return callback(null, true);
-
-        const normalized = normalizeOrigin(origin);
-        if (allowedOriginSet.has(normalized)) return callback(null, true);
-
-        // Secure default for production: require an explicit allowlist.
-        if (isProduction) {
-            return callback(new Error(`CORS origin not allowed: ${origin}`));
-        }
-
-        // Development fallback: permit localhost origins even if env not set.
-        if (!hasExplicitCorsOrigins && (normalized.includes('localhost') || normalized.includes('127.0.0.1'))) {
-            return callback(null, true);
-        }
-
-        return callback(new Error(`CORS origin not allowed: ${origin}`));
-    },
-    methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],
-    allowedHeaders: ['Authorization', 'Content-Type', 'X-Requested-With', 'X-Request-Id', 'X-Qualia-API'],
