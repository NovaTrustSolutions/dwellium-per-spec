+        // Seed recurring scheduler tasks + start scheduler
+        try { seedRecurringTasks(); } catch (err: any) { console.error('[Scheduler] Seed failed:', err.message); }
+        if (process.env.SCHEDULER_ENABLED === 'true') {
+            startScheduler(parseInt(process.env.SCHEDULER_TICK_MS || '60000'));
+        }
