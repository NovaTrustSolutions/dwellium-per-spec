<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly NotebookLM → Dwellium Library sync (plan 052). Install:
    cp com.dwellium.notebooklm-sync.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.dwellium.notebooklm-sync.plist
  Edit the two absolute paths below if your checkout / home differ. launchd does not
  expand ~ — keep paths absolute. The secret comes from the login Keychain
  (security find-generic-password -s dwellium-library-sync), so nothing lives here.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dwellium.notebooklm-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ilyaklipinitser/Downloads/Dwellium -Per Spec/tools/notebooklm/sync.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/ilyaklipinitser/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- Mondays 07:30 local time; launchd runs a missed job at next wake -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/ilyaklipinitser/Library/Logs/dwellium-notebooklm-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ilyaklipinitser/Library/Logs/dwellium-notebooklm-sync.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
