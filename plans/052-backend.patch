+/**
+ * Library Routes — NotebookLM mirror for ARA (plan 052).
+ *
+ *   GET    /api/library/status            (session)
+ *   GET    /api/library/sources           (session)
+ *   POST   /api/library/sources           (corporate+ session OR x-library-secret = LIBRARY_SYNC_SECRET)
+ *   DELETE /api/library/sources/:id       (corporate+ session)
+ *
+ * A source = one NotebookLM source's raw text. id = library:<collection>:<sourceId>;
+ * metadata in library_sources, chunks in embeddings (file_id = id, behind a
+ * type:'library' files row for the FK). Upsert only; re-embeds only when the
+ * sha256 of the text changed. Deleting touches that one id's derived rows only.
+ */
+import { Router, Request, Response, NextFunction } from 'express';
+import * as crypto from 'crypto';
+import { authenticate, requireRole } from '../services/authMiddleware';
+import {
+    indexFile, upsertLibrarySource, getLibrarySource, listLibrarySources, deleteLibrarySource, LibrarySourceRow,
+} from '../services/database';
+import { indexText } from '../services/vectorStore';
+
+const router = Router();
+const MAX_TEXT = 2 * 1024 * 1024;
+
+function secretMatches(given: unknown, expected: string): boolean {
+    if (typeof given !== 'string') return false;
+    const a = Buffer.from(given);
+    const b = Buffer.from(expected);
+    return a.length === b.length && crypto.timingSafeEqual(a, b);
+}
+
+const requireCorporate = requireRole('corporate');
+
+/** Machine path (sync script) when x-library-secret is present — unset LIBRARY_SYNC_SECRET disables it; otherwise a corporate+ session. */
+function adminOrSyncSecret(req: Request, res: Response, next: NextFunction): void {
+    const given = req.headers['x-library-secret'];
+    if (given !== undefined) {
+        const expected = process.env.LIBRARY_SYNC_SECRET;
+        if (expected && secretMatches(given, expected)) return next();
+        res.status(401).json({ success: false, error: 'Unauthorized' });
+        return;
+    }
+    authenticate(req, res, (err?: unknown) => (err ? next(err) : requireCorporate(req, res, next)));
+}
+
+function toApi(r: LibrarySourceRow) {
+    return {
+        id: r.id, collection: r.collection, sourceId: r.source_id, notebookId: r.notebook_id,
+        notebookTitle: r.notebook_title, title: r.title, url: r.url, chars: r.chars, chunks: r.chunks,
+        contentHash: r.content_hash, updatedAt: r.updated_at,
+    };
+}
+
+router.get('/status', authenticate, (_req: Request, res: Response) => {
+    const rows = listLibrarySources();
+    const byCollection = new Map<string, { name: string; sources: number; lastSyncedAt: string | null }>();
+    for (const r of rows) {
+        const c = byCollection.get(r.collection) || { name: r.collection, sources: 0, lastSyncedAt: null };
+        c.sources++;
+        if (!c.lastSyncedAt || r.updated_at > c.lastSyncedAt) c.lastSyncedAt = r.updated_at;
+        byCollection.set(r.collection, c);
+    }
+    const collections = [...byCollection.values()];
+    const lastSyncedAt = collections.reduce<string | null>((m, c) => (!m || (c.lastSyncedAt && c.lastSyncedAt > m) ? c.lastSyncedAt : m), null);
+    res.json({ success: true, embeddingsConfigured: !!process.env.OPENAI_API_KEY, sources: rows.length, collections, lastSyncedAt });
+});
+
+router.get('/sources', authenticate, (_req: Request, res: Response) => {
+    res.json({ success: true, sources: listLibrarySources().map(toApi) });
+});
+
+async function upsertSource(req: Request, res: Response): Promise<void> {
+    const b = (req.body && typeof req.body === 'object' ? req.body : {}) as Record<string, unknown>;
+    const { collection, sourceId, title, text } = b;
+    for (const [k, v] of Object.entries({ collection, sourceId, title, text })) {
+        if (typeof v !== 'string' || !v.trim()) { res.status(400).json({ success: false, error: `${k} is required` }); return; }
+    }
+    if ((text as string).length > MAX_TEXT) { res.status(400).json({ success: false, error: 'text exceeds 2 MB' }); return; }
+    if (!process.env.OPENAI_API_KEY) { res.status(503).json({ success: false, error: 'embeddings not configured' }); return; }
+
+    const id = `library:${collection}:${sourceId}`;
+    const contentHash = crypto.createHash('sha256').update(text as string).digest('hex');
+    const existing = getLibrarySource(id);
+    if (existing && existing.content_hash === contentHash) {
+        res.json({ success: true, id, chunks: existing.chunks, unchanged: true }); return;
+    }
+    const str = (v: unknown): string | null => (typeof v === 'string' && v ? v : null);
+    try {
+        // files row first — embeddings.file_id → files.id (FK ON). INSERT OR REPLACE is upsert-safe here:
+        // the REPLACE-cascade only drops this id's own chunks, which indexText rewrites anyway.
+        indexFile({
+            id, path: id, name: title as string, type: 'library', size: (text as string).length,
+            projectId: null, projectName: null, summary: str(b.url), embeddingId: null, syncedAt: new Date().toISOString(), syncSource: 'notebooklm',
+        });
+        const { chunksIndexed } = await indexText(id, title as string, text as string);
+        upsertLibrarySource({
+            id, collection: collection as string, source_id: sourceId as string, notebook_id: str(b.notebookId), notebook_title: str(b.notebookTitle),
+            title: title as string, url: str(b.url), chars: (text as string).length, chunks: chunksIndexed, content_hash: contentHash,
+        });
+        res.json({ success: true, id, chunks: chunksIndexed, unchanged: false });
+    } catch (err) {
+        const msg = (err as Error).message;
+        if (msg === 'embeddings not configured') { res.status(503).json({ success: false, error: msg }); return; }
+        console.error('[Library] upsert failed:', err);
+        res.status(500).json({ success: false, error: msg });
+    }
+}
+
+router.post('/sources', adminOrSyncSecret, upsertSource);
+
+router.delete('/sources/:id', authenticate, requireCorporate, (req: Request, res: Response) => {
+    const id = req.params.id;
+    if (!id.startsWith('library:')) { res.status(400).json({ success: false, error: 'not a library id' }); return; }
+    deleteLibrarySource(id);
+    res.json({ success: true });
+});
+
+export default router;
