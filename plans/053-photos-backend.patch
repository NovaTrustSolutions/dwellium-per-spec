+describe('Immich OpenAPI drift guard', () => {
+    it('every upstream path the proxy uses exists in the pinned OpenAPI snapshot (tests/fixtures)', () => {
+        // eslint-disable-next-line @typescript-eslint/no-var-requires
+        const { IMMICH_PATHS_USED, albumNameFor } = require('../src/routes/photoRoutes');
+        // eslint-disable-next-line @typescript-eslint/no-var-requires
+        const spec = require('./fixtures/immich-openapi-paths.json');
+        expect(spec.source).toBe('https://raw.githubusercontent.com/immich-app/immich/c98c20e9639257187e1e3b2efa9f1a7f3b465a9d/open-api/immich-openapi-specs.json');
+        expect(spec.securityScheme.apiKey).toMatchObject({ type: 'apiKey', in: 'header', name: 'x-api-key' });
+        for (const p of IMMICH_PATHS_USED) expect(Object.keys(spec.paths)).toContain(p);
+        // methods the proxy relies on must exist on those paths
+        expect(spec.paths['/albums']).toEqual(expect.arrayContaining(['get', 'post']));
+        expect(spec.paths['/albums/{id}/assets']).toEqual(expect.arrayContaining(['put']));
+        expect(spec.paths['/assets']).toEqual(expect.arrayContaining(['post']));
+        expect(spec.paths['/assets/{id}/thumbnail']).toEqual(expect.arrayContaining(['get']));
+        expect(spec.paths['/search/smart']).toEqual(expect.arrayContaining(['post']));
+        expect(spec.paths['/search/metadata']).toEqual(expect.arrayContaining(['post']));
+        expect(spec.paths['/shared-links']).toEqual(expect.arrayContaining(['get', 'post']));
+        // guessed/legacy endpoints must NOT exist (albums moved off /album singular in v2)
+        for (const bad of ['/album', '/asset/upload', '/shared-link']) expect(Object.keys(spec.paths)).not.toContain(bad);
+        // Andy album naming helper is the single naming source
+        expect(albumNameFor('Woodland Parc Townhomes', '12B')).toBe('Woodland Parc Townhomes — 12B');
+        expect(albumNameFor('Riverwood Club Apartments')).toBe('Riverwood Club Apartments');
+    });
