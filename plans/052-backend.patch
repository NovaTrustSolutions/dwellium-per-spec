+/**
+ * plan 052 — Library: NotebookLM-mirrored sources (contracts, housing law, requirements)
+ * retrieved from the SQLite embeddings table (file_id = library:*), grouped by source
+ * title, ~2500 chars total. Returns null (no section, no chips) when nothing matches or
+ * embeddings are unavailable; never throws into the chat path.
+ */
+export const LIBRARY_SECTION_TITLE = 'Library (mirrored from NotebookLM — contracts, housing law, requirements). Cite as [Title].';
+
+export async function buildLibraryContext(userMessage: string): Promise<{ section: string; sources: { name: string; count: number }[] } | null> {
+    try {
+        if (!process.env.OPENAI_API_KEY) return null;
+        // ponytail: brute-force cosine over the SQLite embeddings table — fine to ~10k chunks; upgrade path = a LanceDB table like Georgia Code.
+        const hits = (await searchDocuments(userMessage, 8, 'library:')).filter(h => h.similarity >= 0.25);
+        if (hits.length === 0) return null;
+
+        const bySource = new Map<string, { title: string; chunks: SearchResult[] }>();
+        for (const h of hits) {
+            const g = bySource.get(h.fileId) || { title: getLibrarySource(h.fileId)?.title || h.fileId, chunks: [] };
+            g.chunks.push(h);
+            bySource.set(h.fileId, g);
+        }
+
+        const MAX_CHARS = 2500;
+        let used = 0;
+        const blocks: string[] = [];
+        const sources: { name: string; count: number }[] = [];
+        for (const g of bySource.values()) {
+            const lines: string[] = [];
+            for (const c of g.chunks) {
+                const text = c.text.trim();
+                if (used > 0 && used + text.length > MAX_CHARS) break;
+                used += text.length;
+                lines.push(`- (${(c.similarity * 100).toFixed(0)}% match) ${text}`);
+            }
+            if (lines.length === 0) continue;
+            blocks.push(`### [${g.title}]\n${lines.join('\n')}`);
+            sources.push({ name: g.title, count: lines.length });
+        }
+        if (blocks.length === 0) return null;
+
+        console.log(`[ARA Library] ${hits.length} chunks from ${sources.length} sources`);
+        const section = `## ${LIBRARY_SECTION_TITLE}\n${wrapUntrustedPromptContent('library_sources', blocks.join('\n\n'), MAX_CHARS + 1000)}`;
+        return { section, sources };
+    } catch (err) {
+        console.warn('[ARA Library] context failed:', err);
+        return null;
+    }
+}
