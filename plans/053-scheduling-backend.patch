+describe('cal.com v2 OpenAPI drift guard', () => {
+    it('every upstream path the proxy uses exists in the published v2 OpenAPI snapshot (tests/fixtures)', () => {
+        const { CALCOM_PATHS_USED, CALCOM_API_VERSIONS } = routesModule;
+        // eslint-disable-next-line @typescript-eslint/no-var-requires
+        const spec = require('./fixtures/calcom-v2-paths.json');
+        expect(spec.source).toBe('https://cal.com/docs/api-reference/v2/openapi.json');
+        expect(spec.auth).toMatchObject({ header: 'Authorization', scheme: 'Bearer', apiVersionHeader: 'cal-api-version' });
+        expect(spec.webhook).toMatchObject({ signatureHeader: 'x-cal-signature-256' });
+        for (const p of CALCOM_PATHS_USED) expect(Object.keys(spec.paths)).toContain(p);
+        // methods we call are published for those paths
+        expect(spec.paths['/v2/event-types']).toContain('GET');
+        expect(spec.paths['/v2/bookings']).toContain('GET');
+        expect(spec.paths['/v2/bookings/{bookingUid}/cancel']).toContain('POST');
+        // the per-endpoint cal-api-version constants match the spec's defaults
+        for (const p of CALCOM_PATHS_USED) expect(CALCOM_API_VERSIONS[p]).toBe(spec.apiVersionDefaults[p]);
+        // invented endpoints from older drafts must NOT exist in the spec
+        for (const bad of ['/v2/slots/available', '/v2/bookings/{bookingUid}/cancel-booking']) {
+            expect(Object.keys(spec.paths)).not.toContain(bad);
+        }
+    });
+});
