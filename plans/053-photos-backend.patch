-    'http://127.0.0.1:3000',
-].map(normalizeOrigin);
-const allowedOriginSet = new Set<string>([
-    ...configuredOrigins,
-    ...(!isProduction ? devOrigins : []),
-]);
-const hasExplicitCorsOrigins = configuredOrigins.length > 0;
