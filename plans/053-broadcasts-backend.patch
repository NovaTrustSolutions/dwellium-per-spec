+    const perPage = Math.min(100, Math.max(1, Number.parseInt(String(req.query.per_page ?? '50'), 10) || 50));
+    const params = new URLSearchParams({ page: String(page), per_page: String(perPage) });
+    const listId = Number.parseInt(String(req.query.list_id ?? ''), 10);
+    if (Number.isInteger(listId)) params.set('list_id', String(listId));
+    const query = typeof req.query.query === 'string' ? req.query.query.trim() : '';
+    if (query) params.set('query', query);
+    try {
+        const upstream = await listmonkFetch(cfg, `/subscribers?${params.toString()}`);
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `listmonk subscribers failed (${upstream.status})` }); return; }
+        const parsed = (await upstream.json().catch(() => null)) as Record<string, any> | null;
+        res.json({ success: true, data: resultsOf(parsed), total: parsed?.data?.total ?? resultsOf(parsed).length });
+    } catch (err) {
+        res.status(502).json({ success: false, error: `listmonk unreachable: ${(err as Error).message}` });
+    }
