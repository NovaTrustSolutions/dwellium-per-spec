+/**
+ * OpenAI chat-completions SSE pump (plan 046-A4). Reads a `stream: true`
+ * response body, forwards each `choices[0].delta.content` to onDelta and
+ * returns the joined text + final finish_reason. Pure; no logging.
+ */
+export async function pumpOpenAiSse(
+    body: ReadableStream<Uint8Array>,
+    onDelta: (d: string) => void,
+): Promise<{ text: string; finishReason: string | null }> {
+    const reader = body.getReader();
+    const decoder = new TextDecoder();
+    let buf = '';
+    let text = '';
+    let finishReason: string | null = null;
+    let done = false;
+    const handleBlock = (block: string): void => {
+        for (const line of block.split('\n')) {
+            if (!line.startsWith('data:')) continue;
+            const data = line.slice(5).trim();
+            if (data === '[DONE]') { done = true; return; }
+            let json: any;
+            try { json = JSON.parse(data); } catch { continue; }
+            const choice = json?.choices?.[0];
+            if (!choice) continue;
+            if (typeof choice.delta?.content === 'string' && choice.delta.content) {
+                text += choice.delta.content;
+                onDelta(choice.delta.content);
+            }
+            if (typeof choice.finish_reason === 'string') finishReason = choice.finish_reason;
+        }
+    };
+    while (!done) {
+        const { value, done: eof } = await reader.read();
+        if (eof) break;
+        buf += decoder.decode(value, { stream: true }).replace(/\r\n?/g, '\n');
+        let sep: number;
+        while (!done && (sep = buf.indexOf('\n\n')) !== -1) {
+            handleBlock(buf.slice(0, sep));
+            buf = buf.slice(sep + 2);
+        }
+    }
+    if (!done && buf.trim()) handleBlock(buf);
+    return { text, finishReason };
+}
