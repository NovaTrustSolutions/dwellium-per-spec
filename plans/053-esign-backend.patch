+/** Resolve the Documenso envelope id from a stored esign record or explicit ids (template-flow docs may only know documentId). */
+async function resolveEnvelopeId(cfg: DocumensoConfig, ref: { envelopeId?: unknown; documentId?: unknown }): Promise<string | null> {
+    if (ref.envelopeId) return String(ref.envelopeId);
+    if (ref.documentId === undefined || ref.documentId === null || ref.documentId === '') return null;
+    const r = await documensoJson(cfg, `/document/${encodeURIComponent(String(ref.documentId))}`);
+    if (!r.ok) return null;
+    const j = (await r.json().catch(() => ({}))) as Record<string, any>;
+    return j.envelopeId ? String(j.envelopeId) : null;
