+/** Stream a Documenso download (signed PDF / audit log). v2 answers JSON {downloadUrl} — follow it. */
+async function streamDocumensoDownload(cfg: DocumensoConfig, res: Response, downloadPath: string, fallbackType = 'application/pdf'): Promise<void> {
+    const upstream = await documensoJson(cfg, downloadPath);
+    if (!upstream.ok) { res.status(502).json({ success: false, error: `Documenso download failed (${upstream.status})` }); return; }
+    const ct = upstream.headers.get('content-type') || '';
+    if (ct.includes('application/json')) {
+        const j = (await upstream.json().catch(() => ({}))) as Record<string, any>;
+        const url = j.downloadUrl || j.url;
+        if (!url) { res.status(502).json({ success: false, error: 'Documenso download returned no URL' }); return; }
+        const file = await fetch(url);
+        if (!file.ok) { res.status(502).json({ success: false, error: `Documenso file fetch failed (${file.status})` }); return; }
+        res.setHeader('Content-Type', file.headers.get('content-type') || fallbackType);
+        res.send(Buffer.from(await file.arrayBuffer()));
+        return;
+    }
+    res.setHeader('Content-Type', ct || fallbackType);
+    res.send(Buffer.from(await upstream.arrayBuffer()));
+}
