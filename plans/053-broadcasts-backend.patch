+/** Create-or-update one subscriber. listmonk POST /subscribers answers 409 on
+ *  a duplicate e-mail — then we look the row up by e-mail and PUT with MERGED
+ *  lists + attribs. Never deletes; a blocklisted subscriber stays blocklisted
+ *  (unsubscribes are honored, repo-wide upsert-only rule). */
+async function upsertSubscriber(
+    cfg: ListmonkConfig,
+    sub: { email: string; name: string; lists: number[]; attribs?: Record<string, unknown>; preconfirm?: boolean },
+): Promise<{ ok: true; action: 'created' | 'updated'; data: Record<string, any> } | { ok: false; error: string }> {
+    const createRes = await listmonkFetch(cfg, '/subscribers', {
+        method: 'POST',
+        body: JSON.stringify({
+            email: sub.email,
+            name: sub.name,
+            status: 'enabled',
+            lists: sub.lists,
+            attribs: sub.attribs || {},
+            preconfirm_subscriptions: sub.preconfirm === true,
+        }),
+    });
+    if (createRes.ok) {
+        const created = (await createRes.json().catch(() => ({}))) as Record<string, any>;
+        return { ok: true, action: 'created', data: created.data ?? created };
+    }
+    if (createRes.status !== 409) return { ok: false, error: `listmonk subscriber create failed (${createRes.status})` };
+    const q = encodeURIComponent(`subscribers.email='${sub.email.replace(/'/g, "''")}'`);
+    const findRes = await listmonkFetch(cfg, `/subscribers?page=1&per_page=1&query=${q}`);
+    if (!findRes.ok) return { ok: false, error: `listmonk subscriber lookup failed (${findRes.status})` };
+    const existing = resultsOf(await findRes.json().catch(() => null))[0] as Record<string, any> | undefined;
+    if (!existing?.id) return { ok: false, error: 'duplicate subscriber not found by e-mail' };
+    const existingLists = Array.isArray(existing.lists)
+        ? existing.lists.map((l: Record<string, any>) => l?.id).filter((n: unknown) => Number.isInteger(n))
+        : [];
+    const putRes = await listmonkFetch(cfg, `/subscribers/${existing.id}`, {
+        method: 'PUT',
+        body: JSON.stringify({
+            email: sub.email,
+            name: sub.name || existing.name,
+            status: existing.status === 'blocklisted' ? 'blocklisted' : 'enabled',
+            lists: [...new Set([...existingLists, ...sub.lists])],
+            attribs: { ...(existing.attribs || {}), ...(sub.attribs || {}) },
+            preconfirm_subscriptions: sub.preconfirm === true,
+        }),
+    });
+    if (!putRes.ok) return { ok: false, error: `listmonk subscriber update failed (${putRes.status})` };
+    const updated = (await putRes.json().catch(() => ({}))) as Record<string, any>;
+    return { ok: true, action: 'updated', data: updated.data ?? existing };
+}
