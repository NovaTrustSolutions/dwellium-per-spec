+                content_type: typeof body.content_type === 'string' ? body.content_type : (campaign.content_type || 'richtext'),
+                body: typeof body.body === 'string' ? body.body : (campaign.body || ''),
+                ...(Number.isInteger(body.template_id) ? { template_id: body.template_id } : (campaign.template_id ? { template_id: campaign.template_id } : {})),
+                ...(sendAt ? { send_at: sendAt } : {}),
+            }),
+        });
+        if (!upstream.ok) { res.status(502).json({ success: false, error: `listmonk campaign update failed (${upstream.status})` }); return; }
+        const updated = (await upstream.json().catch(() => ({}))) as Record<string, any>;
+        res.json({ success: true, data: updated.data ?? updated });
