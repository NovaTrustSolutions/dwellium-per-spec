+{
+ "source": "https://design.penpot.app/api/main/doc",
+ "note": "Penpot's backend API documentation, generated automatically from source code and linked from the Integration Guide. /api/_doc and /api/doc both 308-redirect here. There is no OpenAPI/Swagger JSON: https://design.penpot.app/api/openapi.json returns HTTP 404 (checked 2026-08-23), so this snapshot is extracted from the published HTML doc page rather than a machine spec.",
+ "docPages": [
+  "https://help.penpot.app/technical-guide/integration/",
+  "https://design.penpot.app/api/main/doc"
+ ],
+ "fetchedAt": "2026-08-23",
+ "authScheme": {
+  "header": "Authorization",
+  "format": "Token <access-token>",
+  "source": "https://help.penpot.app/technical-guide/integration/#access-tokens",
+  "curlExample": "curl -H \"Authorization: Token <replace-this-with-token>\" https://design.penpot.app/api/rpc/command/get-profile"
+ },
+ "rpcPathTemplate": "/api/rpc/command/{command}",
+ "contentNegotiation": {
+  "accepts": ["application/json", "application/transit+json"],
+  "default": "application/transit+json",
+  "note": "The doc's Content Negotiation section: specify the desired content-type on the Accept header; transit encoding is used by default. The proxy therefore sends Accept: application/json explicitly."
+ },
+ "commands": {
+  "get-teams": {
+   "params": "type GetTeams { }",
+   "addedIn": "v1.17",
+   "labels": ["AUTH", "SCHEMA"]
+  },
+  "get-projects": {
+   "params": "type GetProjects { teamId: uuid }",
+   "addedIn": "v1.18",
+   "labels": ["AUTH", "SCHEMA"]
+  },
+  "get-project-files": {
+   "params": "type GetProjectFiles { projectId: uuid }",
+   "addedIn": "v1.17",
+   "docstring": "Get all files for the specified project.",
+   "labels": ["AUTH", "SCHEMA"]
+  },
+  "export-binfile": {
+   "params": "type ExportBinfile { fileId: uuid, includeLibraries: boolean, embedAssets: boolean }",
+   "addedIn": "v1.15",
+   "docstring": "Export a penpot file in a binary format.",
+   "labels": ["AUTH", "WEBHOOK", "SCHEMA"]
+  }
+ },
+ "notProxied": {
+  "renderExport": {
+   "formats": ["PNG", "JPEG", "WEBP", "SVG", "PDF"],
+   "reason": "Rendered exports are produced by the separate penpot-exporter service; its HTTP endpoints are an internal implementation detail, not part of the documented RPC surface. Not proxied rather than invented.",
+   "source": "https://help.penpot.app/technical-guide/developer/architecture/exporter/"
+  }
+ }
+}
